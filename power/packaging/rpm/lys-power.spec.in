%global debug_package %{nil}
%global _build_id_links none

Name:           lys-power
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Adaptive battery charging and power profile policy for the lys desktop
License:        MIT AND BSD-2-Clause AND BSD-3-Clause
URL:            https://github.com/stubbedev/lys/tree/main/power
Source0:        https://github.com/stubbedev/lys/releases/download/v%{version}/lys-power-%{version}-%{_arch}-linux.tar.gz
ExclusiveArch:  x86_64 aarch64

BuildRequires:  systemd-rpm-macros
Requires:       systemd

%description
lys-power holds a laptop's battery at 75-80% while it is plugged in and learns when the charger usually comes out, charging to 100% in the two hours before that moment. It also sets the power profile itself, the ACPI platform profile and the CPUs' energy preference, on every AC edge: performance on AC, power-saver on battery. It does not start beside power-profiles-daemon or tuned-ppd, which set the same knobs.

As a user service, lys-power-brightness sets the screen brightness from an ambient light sensor, or else from short camera captures that are never kept or sent anywhere.

When lys-shell's idle policy asks, the lys-power-attention user service, started over D-Bus, checks with one short camera capture whether a face is turned to the screen before it dims; the frames are never kept or sent anywhere either.

The package enables nothing: start the system service with systemctl enable --now lys-power, and automatic brightness with systemctl --user enable --now lys-power-brightness.

%prep
%setup -q -n lys-power-%{version}-%{_arch}-linux

%build

%install
install -d %{buildroot}%{_bindir}
install -m 0755 lys-power %{buildroot}%{_bindir}/

install -d %{buildroot}%{_unitdir}
install -m 0644 lys-power.service %{buildroot}%{_unitdir}/

install -d %{buildroot}%{_userunitdir}
install -m 0644 lys-power-brightness.service %{buildroot}%{_userunitdir}/
install -m 0644 lys-power-attention.service %{buildroot}%{_userunitdir}/
install -D -m 0644 dev.stubbe.lys.Attention1.service %{buildroot}%{_datadir}/dbus-1/services/dev.stubbe.lys.Attention1.service

install -D -m 0644 lys-power.tmpfiles %{buildroot}%{_tmpfilesdir}/lys-power.conf

install -D -m 0644 dev.stubbe.lys.Energy1.conf %{buildroot}%{_datadir}/dbus-1/system.d/dev.stubbe.lys.Energy1.conf
install -D -m 0644 dev.stubbe.lys.Pause1.conf %{buildroot}%{_datadir}/dbus-1/system.d/dev.stubbe.lys.Pause1.conf
install -D -m 0644 dev.stubbe.lys.Charge1.conf %{buildroot}%{_datadir}/dbus-1/system.d/dev.stubbe.lys.Charge1.conf
install -D -m 0644 dev.stubbe.lys.Profile1.conf %{buildroot}%{_datadir}/dbus-1/system.d/dev.stubbe.lys.Profile1.conf
install -D -m 0644 dev.stubbe.lys.power.policy %{buildroot}%{_datadir}/polkit-1/actions/dev.stubbe.lys.power.policy

install -D -m 0644 dev.stubbe.lys.Nap1.conf %{buildroot}%{_datadir}/dbus-1/system.d/dev.stubbe.lys.Nap1.conf
install -D -m 0644 dev.stubbe.lys.Sleep1.conf %{buildroot}%{_datadir}/dbus-1/system.d/dev.stubbe.lys.Sleep1.conf

%post
%systemd_post lys-power.service
%tmpfiles_create lys-power.conf

%preun
%systemd_preun lys-power.service

%postun
%systemd_postun lys-power.service

%files
%license LICENSE
%{_bindir}/lys-power
%{_unitdir}/lys-power.service
%{_userunitdir}/lys-power-brightness.service
%{_userunitdir}/lys-power-attention.service
%{_datadir}/dbus-1/services/dev.stubbe.lys.Attention1.service
%{_tmpfilesdir}/lys-power.conf
%{_datadir}/dbus-1/system.d/dev.stubbe.lys.Energy1.conf
%{_datadir}/dbus-1/system.d/dev.stubbe.lys.Pause1.conf
%{_datadir}/dbus-1/system.d/dev.stubbe.lys.Charge1.conf
%{_datadir}/dbus-1/system.d/dev.stubbe.lys.Profile1.conf
%{_datadir}/polkit-1/actions/dev.stubbe.lys.power.policy
%{_datadir}/dbus-1/system.d/dev.stubbe.lys.Nap1.conf
%{_datadir}/dbus-1/system.d/dev.stubbe.lys.Sleep1.conf

%changelog
* @DATE@ @MAINTAINER@ - @VERSION@-1
- Packaged upstream binary release
