#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:

override_dh_dwz:

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start --no-stop-on-upgrade

override_dh_installsystemduser:
	dh_installsystemduser --no-enable

override_dh_auto_install:
	install -d debian/lys-power/usr/bin
	install -m 0755 lys-power debian/lys-power/usr/bin/

	install -d debian/lys-power/usr/lib/systemd/system
	install -m 0644 lys-power.service debian/lys-power/usr/lib/systemd/system/

	install -d debian/lys-power/usr/lib/systemd/user
	install -m 0644 lys-power-brightness.service debian/lys-power/usr/lib/systemd/user/
	install -m 0644 lys-power-attention.service debian/lys-power/usr/lib/systemd/user/
	install -D -m 0644 dev.stubbe.lys.Attention1.service debian/lys-power/usr/share/dbus-1/services/dev.stubbe.lys.Attention1.service

	install -D -m 0644 lys-power.tmpfiles debian/lys-power/usr/lib/tmpfiles.d/lys-power.conf

	install -D -m 0644 dev.stubbe.lys.Energy1.conf debian/lys-power/usr/share/dbus-1/system.d/dev.stubbe.lys.Energy1.conf
	install -D -m 0644 dev.stubbe.lys.Pause1.conf debian/lys-power/usr/share/dbus-1/system.d/dev.stubbe.lys.Pause1.conf
	install -D -m 0644 dev.stubbe.lys.Charge1.conf debian/lys-power/usr/share/dbus-1/system.d/dev.stubbe.lys.Charge1.conf
	install -D -m 0644 dev.stubbe.lys.Profile1.conf debian/lys-power/usr/share/dbus-1/system.d/dev.stubbe.lys.Profile1.conf
	install -D -m 0644 dev.stubbe.lys.power.policy debian/lys-power/usr/share/polkit-1/actions/dev.stubbe.lys.power.policy
	install -D -m 0644 dev.stubbe.lys.Nap1.conf debian/lys-power/usr/share/dbus-1/system.d/dev.stubbe.lys.Nap1.conf
	install -D -m 0644 dev.stubbe.lys.Sleep1.conf debian/lys-power/usr/share/dbus-1/system.d/dev.stubbe.lys.Sleep1.conf
