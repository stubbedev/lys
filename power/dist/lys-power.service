[Unit]
Description=lys-power adaptive battery charging and power profile policy
Documentation=https://github.com/stubbedev/lys/tree/main/power
After=power-profiles-daemon.service upower.service

[Service]
Type=simple
ExecStart=/usr/bin/lys-power run
StateDirectory=lys-power
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=-/run/battery-charge -/sys/module/pcie_aspm/parameters/policy -/sys/module/snd_hda_intel/parameters/power_save
ReadOnlyPaths=/proc/sys -/proc/sysrq-trigger -/proc/acpi -/proc/fs -/proc/irq -/sys/kernel -/sys/module -/sys/power -/sys/firmware -/sys/fs
ProtectHome=read-only
PrivateTmp=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=graphical.target
