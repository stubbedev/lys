# lys-secrets dev tasks.

# List all recipes with their descriptions.
default:
    @just --list

# Run every release gate in order: vet, lint, test, race, build.
check: vet lint test race build

# Static analysis of every package with go vet.
vet:
    go vet ./...

# Lint without changing anything: formatting and golangci-lint
# (settings in .golangci.yml).
lint:
    golangci-lint fmt --diff
    golangci-lint run

# Run the test suite in a random order, so a test that leans on state an
# earlier one left behind fails instead of passing by declaration order.
test *args:
    go test ${LYS_TEST_ARGS--shuffle=on} ./... {{ args }}

# Run the test suite under the race detector, which needs cgo.
race:
    CGO_ENABLED=1 go test -race ${LYS_TEST_ARGS--shuffle=on} ./...

# Compile-check every package; the output is discarded.
build:
    go build -o /dev/null ./...

# Build the release binary into dist/: static and stripped, as the
# archive and the Debian and RPM packages ship it.
dist:
    CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o dist/ ./cmd/lys-secrets

# Format every Go source in place (gofumpt and gci via golangci-lint).
fmt:
    golangci-lint fmt

# Pack the dist/ build into lys-secrets-<version>-<arch>-linux.tar.gz, the release
# archive the packages are built from.
[script("bash")]
archive version arch=arch() dist="dist":
    set -euo pipefail
    staging="lys-secrets-{{ version }}-{{ arch }}-linux"
    rm -rf "${staging}"
    mkdir -p "${staging}"
    cp "{{ dist }}/lys-secrets" LICENSE \
        resources/lys-secrets.service \
        resources/org.freedesktop.secrets.service \
        resources/dev.stubbe.lys.Vault1.service \
        "${staging}/"
    tar czf "${staging}.tar.gz" "${staging}"
    rm -rf "${staging}"

# Build the archive and the .deb and .rpm from dist/: `just secrets::package 0.5.0 deb`.
package version format="": (archive version)
    just --justfile ../packaging/justfile build secrets "{{ justfile_directory() }}/lys-secrets-{{ version }}-{{ arch() }}-linux.tar.gz" "{{ version }}" "{{ format }}"

# Install a .deb or .rpm built by package (as root) and check it runs.
[script("bash")]
smoke-test package:
    set -euo pipefail
    just --justfile ../packaging/justfile install "$(readlink -f "{{ package }}")"
    fail() {
        echo "smoke test: $*" >&2
        exit 1
    }

    status=0
    out="$(lys-secrets unexpected 2>&1)" || status=$?
    [[ ${status} -eq 2 ]] || fail "lys-secrets with an argument exited ${status}, want its usage error (2)"
    [[ ${out} == *'unexpected argument "unexpected"'* ]] || fail "lys-secrets with an argument printed ${out@Q}"

    for file in /usr/lib/systemd/user/lys-secrets.service /usr/share/lys-secrets/org.freedesktop.secrets.service \
        /usr/share/lys-secrets/dev.stubbe.lys.Vault1.service; do
        [[ -f ${file} ]] || fail "${file} is missing"
    done

    [[ ! -e /etc/systemd/user/default.target.wants/lys-secrets.service ]] || fail "installing enabled lys-secrets.service"

    echo "smoke test: {{ package }} installs and runs"
