# lys-settings dev tasks.

set shell := ["bash", "-euo", "pipefail", "-c"]

# List all recipes with their descriptions.
default:
    @just --list

# Run every release gate in order: vet, lint, the FMA check, the tests, the race
# detector, build. The tests start a headless lys-wm: run this as `just docker
# check`, away from the desktop session.
check: vet lint no-fused test race build

# Static analysis of every package with go vet.
vet:
    go vet ./...

# Lint every package; settings live in .golangci.yml.
lint:
    golangci-lint fmt --diff
    golangci-lint run

# Fail on any float product fused into an FMA, which rounds differently from amd64.
no-fused:
    no-fused

# Run the test suite for every package, the end-to-end test against a headless
# lys-wm in a private runtime directory included, or for $LYS_TEST_PACKAGES, the
# tests $LYS_TEST_RUN picks and $LYS_TEST_SKIP leaves of one CI part.
test:
    LYS_SETTINGS_HEADLESS=1 go test -run "${LYS_TEST_RUN-}" -skip "${LYS_TEST_SKIP-}" ${LYS_TEST_ARGS--count=1 -shuffle=on} ${LYS_TEST_PACKAGES:-./...}

# Every package under the race detector, which needs cgo, or one CI part of
# them, as the test recipe picks it.
race:
    CGO_ENABLED=1 LYS_SETTINGS_HEADLESS=1 go test -race -run "${LYS_TEST_RUN-}" -skip "${LYS_TEST_SKIP-}" ${LYS_TEST_ARGS--count=1 -shuffle=on} ${LYS_TEST_PACKAGES:-./...}

# Compile-check every package; the output is discarded.
build:
    go build -o /dev/null ./...

# Build the release binary into dist/, as the archive and the packages ship it.
dist:
    just --justfile ../packaging/justfile --working-directory "{{ justfile_directory() }}" go-build dist ./cmd/lys-settings ./cmd/lys-users
    go tool install-icons dist/icons/hicolor/scalable/actions $(cat resources/icons.txt)

# Run the settings app.
run *args:
    go run ./cmd/lys-settings {{ args }}

# Format every Go source in place.
fmt:
    golangci-lint fmt

# Run a recipe in the flake's dev shell inside a throwaway container, so nothing
# the tests start reaches the desktop session: no host runtime dir, display, bus
# or DRM node.
docker recipe="check" memory="6g":
    #!/usr/bin/env bash
    set -euo pipefail
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    nix print-dev-env .#settings > "$dir/env.sh"
    printf 'root:x:0:0::/root:/bin/sh\nlys-settings:x:%s:%s::/go/home:/bin/sh\n' "$(id -u)" "$(id -g)" > "$dir/passwd"
    printf 'root:x:0:\nlys-settings:x:%s:\n' "$(id -g)" > "$dir/group"
    bash=$(nix build --inputs-from . --no-link --print-out-paths nixpkgs#bash^out)/bin/bash
    certs=$(nix build --inputs-from . --no-link --print-out-paths nixpkgs#cacert^out)/etc/ssl/certs/ca-bundle.crt
    docker volume create lys-settings-go > /dev/null
    docker run --rm -v lys-settings-go:/go debian:trixie-slim chown "$(id -u):$(id -g)" /go
    forward=()
    [[ -v LYS_TEST_ARGS ]] && forward+=(-e LYS_TEST_ARGS)
    [[ -v LYS_SETTINGS_SHOTS_PAGES ]] && forward+=(-e LYS_SETTINGS_SHOTS_PAGES)
    docker run --rm --init --user "$(id -u):$(id -g)" --cap-add SYS_PTRACE "${forward[@]}" \
        --memory {{ quote(memory) }} --memory-swap {{ quote(memory) }} --pids-limit 4096 --tmpfs /dev/shm:rw,nosuid,nodev,exec,size=1g,mode=1777 \
        -v /nix/store:/nix/store:ro -v "$dir/env.sh:/env.sh:ro" -v "$dir/passwd:/etc/passwd:ro" -v "$dir/group:/etc/group:ro" -v "$(git rev-parse --show-toplevel):/src" -v lys-settings-go:/go -w /src/settings -e SSL_CERT_FILE="$certs" \
        debian:trixie-slim "$bash" -c 'source /env.sh && export HOME=/go/home GOMODCACHE=/go/mod GOCACHE=/go/cache GOLANGCI_LINT_CACHE=/go/lint TMPDIR=/tmp && unset XDG_RUNTIME_DIR WAYLAND_DISPLAY DISPLAY DBUS_SESSION_BUS_ADDRESS && mkdir -p "$HOME" && exec just "$1"' docker {{ quote(recipe) }}

# Screenshot every settings page, scrolled through, and every dialog, popover
# and menu a click on it opens, into shots/ (or only the comma-separated pages
# given), against a headless lys-wm in a throwaway container. A review aid:
# the shots are looked at, not compared. A full run takes most of an hour, so
# give pages when checking a change.
shots pages="":
    LYS_SETTINGS_SHOTS_PAGES={{ quote(pages) }} just docker shots-in 8g

# The inside of shots: the app's and lys-shell's icons installed where the
# window finds them, then TestShots writing into shots/.
[script("bash")]
shots-in:
    set -euo pipefail
    icons="$(mktemp -d)"
    trap 'rm -rf "${icons}"' EXIT
    go tool install-icons "${icons}/settings/hicolor/scalable/actions" $(cat resources/icons.txt)
    go tool install-icons "${icons}/lys-shell/hicolor/scalable/actions"
    mkdir -p shots
    LYS_SETTINGS_HEADLESS=1 LYS_SETTINGS_SHOTS="$PWD/shots" \
        LYS_SETTINGS_SHOTS_ICONS="${icons}/settings" LYS_SETTINGS_SHOTS_SHELL_ICONS="${icons}/lys-shell" \
        go test -run '^TestShots$' -count=1 -timeout 90m ./internal/settings

# Pack the dist/ build into lys-settings-<version>-<arch>-linux.tar.gz, the release
# archive the packages are built from.
[script("bash")]
archive version arch=arch() dist="dist":
    set -euo pipefail
    staging="lys-settings-{{ version }}-{{ arch }}-linux"
    rm -rf "${staging}"
    mkdir -p "${staging}/icons"
    cp "{{ dist }}/lys-settings" "{{ dist }}/lys-users" LICENSE \
        resources/dev.stubbe.lys.settings.desktop \
        resources/lys-settings.svg \
        resources/dev.stubbe.lys.settings.users.policy \
        resources/dev.stubbe.lys.Users1.conf \
        resources/dev.stubbe.lys.Users1.service \
        resources/lys-users.service \
        "${staging}/"
    cp -R "{{ dist }}/icons/hicolor" "${staging}/icons/"
    tar czf "${staging}.tar.gz" "${staging}"
    rm -rf "${staging}"

# Build the archive and the .deb and .rpm from dist/: `just settings::package 0.5.0 deb`.
package version format="": (archive version)
    just --justfile ../packaging/justfile build settings "{{ justfile_directory() }}/lys-settings-{{ version }}-{{ arch() }}-linux.tar.gz" "{{ version }}" "{{ format }}"

# Install a .deb or .rpm built by package (as root) and check it runs.
[script("bash")]
smoke-test package:
    set -euo pipefail
    just --justfile ../packaging/justfile install "$(readlink -f "{{ package }}")"
    fail() {
        echo "smoke test: $*" >&2
        exit 1
    }

    for file in /usr/share/applications/dev.stubbe.lys.settings.desktop \
        /usr/share/icons/hicolor/scalable/apps/lys-settings.svg \
        /usr/share/lys-settings/icons/hicolor/scalable/actions/ld-x-symbolic.svg \
        /usr/share/polkit-1/actions/dev.stubbe.lys.settings.users.policy \
        /usr/share/dbus-1/system.d/dev.stubbe.lys.Users1.conf \
        /usr/share/dbus-1/system-services/dev.stubbe.lys.Users1.service \
        /usr/lib/systemd/system/lys-users.service; do
        [[ -f ${file} ]] || fail "${file} is missing"
    done

    home="$(mktemp -d)"
    trap 'rm -rf "${home}"' EXIT
    pages="$(HOME="${home}" XDG_CONFIG_HOME="${home}/config" lys-settings --list-pages)"
    [[ ${pages} == *'"id":"overview"'* ]] || fail "--list-pages printed ${pages@Q}"

    status=0
    lys-settings --bogus >/dev/null 2>&1 || status=$?
    [[ ${status} -eq 2 ]] || fail "an unknown flag exited ${status}, want 2"

    [[ -x /usr/libexec/lys-users ]] || fail "/usr/libexec/lys-users is missing"
    status=0
    /usr/libexec/lys-users --bogus >/dev/null 2>&1 || status=$?
    [[ ${status} -eq 2 ]] || fail "lys-users with an unknown flag exited ${status}, want 2"

    echo "smoke test: {{ package }} installs and runs"
