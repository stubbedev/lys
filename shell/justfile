set shell := ["bash", "-euo", "pipefail", "-c"]

# The flake dev shell (nix/shell.nix, loaded by direnv through .envrc)
# pins the Go toolchain go.mod names and adds the lint stack, fonts, and
# a headless sway; a plain PATH `go` at that version works too.
go := "go"

# Where `just dist` puts the binaries.
dist := "dist"

# Default — list recipes.
default:
    @just --list --unsorted

# ─────────────────────────── Build & Run ───────────────────────────

# Build the release binaries into dist/ (lys-ui dlopens what it needs through
# purego), and the shell completions, generated by a host build so packaging
# never runs a binary made for another system's loader.
dist:
    just --justfile ../packaging/justfile --working-directory "{{ justfile_directory() }}" go-build {{ dist }} ./cmd/lys-shell ./cmd/lys-lock
    install -m 0644 "../desktop/service/bitwarden/generator/eff_large_wordlist.NOTICE" {{ dist }}/
    {{ go }} tool install-icons {{ dist }}/icons/hicolor/scalable/actions
    {{ go }} run ./internal/tools/distcheck {{ dist }}/lys-shell {{ dist }}/lys-lock
    mkdir -p {{ dist }}/completions
    {{ go }} run ./cmd/lys-shell completions bash > {{ dist }}/completions/completions.bash
    {{ go }} run ./cmd/lys-shell completions zsh > {{ dist }}/completions/_lys-shell
    {{ go }} run ./cmd/lys-shell completions fish > {{ dist }}/completions/lys-shell.fish

# Run the lys-shell binary. Extra args pass through: `just run config get bar.location`.
run *args:
    {{ go }} run ./cmd/lys-shell {{ args }}

# Stop the packaged shell so a dev build can take over (only one instance may
# hold the dev.stubbe.lys.shell bus name), run it, then restore the service on exit.
dev-shell *args:
    #!/usr/bin/env bash
    set -uo pipefail
    was_active=$(systemctl --user is-active lys-shell.service || true)
    if [ "$was_active" = "active" ]; then systemctl --user stop lys-shell.service; fi
    trap '[ "$was_active" = "active" ] && systemctl --user start lys-shell.service' EXIT
    {{ go }} run ./cmd/lys-shell shell {{ args }}

# Tail today's shell log — `just logs 200` for more backlog.
logs lines="80":
    tail -n {{ lines }} -f "${XDG_STATE_HOME:-$HOME/.local/state}/lys-shell/lys-shell.$(date +%F).log"

# Remove the build output.
clean:
    rm -rf {{ dist }}

# ─────────────────────────── Check ───────────────────────────

# Format every package in place (gofumpt and gci via golangci-lint).
fmt:
    golangci-lint fmt

# Static analysis of every package with go vet.
vet:
    {{ go }} vet ./...

# Lint without changing anything: formatting and golangci-lint
# Fail on any float product fused into an FMA, which rounds differently from amd64.
no-fused:
    no-fused

# (settings in .golangci.yml).
lint:
    golangci-lint fmt --diff
    golangci-lint run

# Run the test suite in a random order, so a test that leans on state an
# earlier one left behind fails instead of passing by declaration order.
test *args:
    {{ go }} test ${LYS_TEST_ARGS--shuffle=on} ${LYS_TEST_PACKAGES:-./...} {{ args }}

# Run the test suite under the race detector. It needs cgo (a C
# toolchain), which the shipped CGO_ENABLED=0 build never does.
race:
    CGO_ENABLED=1 {{ go }} test -race ${LYS_TEST_ARGS--shuffle=on} ${LYS_TEST_PACKAGES:-./...}

# The committed config schema must be what the binary generates.
schema-check:
    #!/usr/bin/env bash
    set -euo pipefail
    got=$(mktemp)
    trap 'rm -f "$got"' EXIT
    {{ go }} run ./cmd/lys-shell config schema --stdout > "$got"
    if ! diff -u schema/lys-shell-config.schema.json "$got"; then
        echo "Config schema is out of date: run \`just schema\`." >&2
        exit 1
    fi

# Run a recipe in the flake's dev shell inside a throwaway debian container,
# so nothing the tests start (sway, dbus, pipewire, the portal) reaches the
# desktop session: no host runtime dir, display or session bus. The nix
# store is mounted read-only, the Go caches live in a named volume, the
# container user has a passwd entry, and the GPU comes in through its render
# and NVIDIA nodes only. Memory is capped, as the race suite runs many
# binaries. An empty /run/systemd/system, private to the container, is all
# loginctl asks before it talks to the fake logind on a private bus; nothing of
# the host's systemd is there. `just docker race` or `just docker check`.
docker recipe="check" memory="10g":
    #!/usr/bin/env bash
    set -euo pipefail
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    nix print-dev-env --accept-flake-config .#shell > "$dir/env.sh"
    printf 'root:x:0:0::/root:/bin/sh\nlys-shell:x:%s:%s::/go/home:/bin/sh\n' "$(id -u)" "$(id -g)" > "$dir/passwd"
    printf 'root:x:0:\nlys-shell:x:%s:\n' "$(id -g)" > "$dir/group"
    bash=$(nix build --inputs-from . --no-link --print-out-paths nixpkgs#bash^out)/bin/bash
    certs=$(nix build --inputs-from . --no-link --print-out-paths nixpkgs#cacert^out)/etc/ssl/certs/ca-bundle.crt
    docker volume create lys-shell-go > /dev/null
    docker run --rm -v lys-shell-go:/go debian:trixie-slim chown "$(id -u):$(id -g)" /go
    gpu=()
    for node in /dev/dri/renderD* /dev/nvidia*; do
        [[ -c "$node" ]] && gpu+=(--device "$node" --group-add "$(stat -c %g "$node")")
    done
    if [[ -e /run/opengl-driver ]]; then
        gpu+=(-v /run/opengl-driver:/run/opengl-driver:ro)
    fi
    docker run --rm --init --user "$(id -u):$(id -g)" --device /dev/kvm "${gpu[@]}" --tmpfs /run/systemd/system \
        --memory {{ quote(memory) }} --memory-swap {{ quote(memory) }} --pids-limit 4096 --tmpfs /dev/shm:rw,nosuid,nodev,exec,size=1g,mode=1777 \
        -v /nix/store:/nix/store:ro -v "$dir/env.sh:/env.sh:ro" -v "$dir/passwd:/etc/passwd:ro" -v "$dir/group:/etc/group:ro" -v "$(git rev-parse --show-toplevel):/src" -v lys-shell-go:/go -w /src/shell -e SSL_CERT_FILE="$certs" \
        debian:trixie-slim "$bash" -c 'source /env.sh && export HOME=/go/home GOMODCACHE=/go/mod GOCACHE=/go/cache GOLANGCI_LINT_CACHE=/go/lint TMPDIR=/tmp && unset XDG_RUNTIME_DIR WAYLAND_DISPLAY DISPLAY DBUS_SESSION_BUS_ADDRESS && mkdir -p "$HOME" && exec just "$1"' docker {{ quote(recipe) }}

# The shell on a live Hyprland in a NixOS VM (needs KVM): bars on every
# output and hotplug, the Hyprland modules, launcher, popups, and the
# session lock across a shell restart, then lys-ui's compositor-in-the-loop
# suite on a Hyprland of its own in the same boot. Screenshots of every
# state land in ./result.
hyprland-vms:
    nix build -L .#checks.{{ arch() }}-{{ os() }}.shell-hyprland-vms

# The shell on lys-wm in a NixOS VM (needs KVM): bars on both outputs,
# the lys-wm workspaces, window title, keybind mode and keyboard layout
# modules following lys-wm's IPC, the layout toast, screenshots and the
# session lock. Screenshots of every state land in ./result.
lys-wm-vm:
    nix build -L .#checks.{{ arch() }}-{{ os() }}.desktop-vms-session

# The wall-clock jump watcher on a real kernel in a NixOS VM (needs KVM):
# clock steps and the kernel's suspend and resume, the last scenario of the
# shared system VM.
clockwatch-vm:
    nix build -L .#checks.{{ arch() }}-{{ os() }}.desktop-vms-system

# Every release gate: the ones CI runs in `plain` and the race detector, which
# it runs as a separate job.
check: plain race

# Every release gate but the race detector, in order: vet, lint, test, the
# schema check, and the release build.
plain: vet lint no-fused test schema-check dist

# Check the screen recorder on this machine's GPU (run it in the dev
# shell): a private headless sway renders on the first render node with
# Vulkan, the recorder records 3 s of it into MP4 and Matroska with
# audio, and the log shows the Vulkan device, the modifier the capture
# took, the codecs the device encodes, and ffprobe's reading of each
# file; every output transform and a region are recorded and checked
# upright, and an instant replay is saved while it runs and checked.
# A GPU without an H.264 encoder says so, and why, instead.
# LYS_TEST_GPU makes it a hardware check: a run that cannot reach the
# GPU (no render node, no Vulkan driver for it, no encoder) fails
# instead of skipping.
recorder-check:
    LYS_TEST_GPU=host {{ go }} test -count=1 -v -run '^(TestNoH264EncoderIsTheDefinedError|TestRecordsAnOutputOnTheGPU|TestWebcamOverlayIsEncodedIntoTheFrame|TestRecordsTransformedOutputsAndRegionsUpright|TestReplayOnTheGPU)$' ./service/recorder/

# ─────────────────────────── Generated files ───────────────────────────

# Regenerate the committed config JSON schema. Its $id embeds the version,
# so the release flow rewrites it on every bump.
schema:
    {{ go }} run ./cmd/lys-shell config schema --stdout > schema/lys-shell-config.schema.json

# Regenerate the launcher's Unicode character name table from the Unicode
# Character Database of the pinned nixpkgs.
unicode-names:
    {{ go }} run ./internal/tools/unicodegen "$(nix build --inputs-from . --no-link --print-out-paths nixpkgs#unicode-character-database)/share/unicode" service/launcher/charnames/names.bin.gz

# Push the shell's build to the xilo cache. --url is passed explicitly because the cache is a property of this project,
# not of the machine: with no profile and no XILO_URL, xilo falls back to
# localhost:8080 and the push dies with "no server configured" after the
# build. Credentials stay the machine's business; the check below only
# refuses to start that build when there are none to be found.
cache-push:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -z "${XILO_TOKEN:-}" ] && \
       [ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/xilo/config.yaml" ]; then
        echo "Error: no push credentials — set XILO_TOKEN, or run:" >&2
        echo "  xilo login https://xilos.dev --token <tok> --cache stubbedev/main" >&2
        exit 1
    fi
    nix build .#lys-shell -L --accept-flake-config
    xilo push stubbedev/main ./result --url https://xilos.dev

# Pack the dist/ build into lys-shell-<version>-<arch>-linux.tar.gz, the release
# archive the packages are built from.
[script("bash")]
archive version arch=arch() dist="dist":
    set -euo pipefail
    staging="lys-shell-{{ version }}-{{ arch }}-linux"
    rm -rf "${staging}"
    mkdir -p "${staging}/icons" "${staging}/completions"
    cp "{{ dist }}/lys-shell" "{{ dist }}/lys-lock" LICENSE "{{ dist }}/eff_large_wordlist.NOTICE" "${staging}/"
    cp "{{ dist }}/completions/completions.bash" "{{ dist }}/completions/_lys-shell" "{{ dist }}/completions/lys-shell.fish" "${staging}/completions/"
    cp -R "{{ dist }}/icons/hicolor" "${staging}/icons/"
    cp resources/lys-shell.service \
        resources/dev.stubbe.lys.vpn-sso-callback.desktop \
        resources/lys-shell.portal \
        resources/lys-shell-lys-wm.portal \
        resources/org.freedesktop.impl.portal.desktop.lys.service \
        resources/dev.stubbe.lys.*.service \
        resources/xdg-desktop-portal-lys-shell.service \
        resources/lys-shell-portals.conf \
        "${staging}/"
    tar czf "${staging}.tar.gz" "${staging}"
    rm -rf "${staging}"

# Build the archive and the .deb and .rpm from dist/: `just shell::package 0.5.0 deb`.
package version format="": (archive version)
    just --justfile ../packaging/justfile build shell "{{ justfile_directory() }}/lys-shell-{{ version }}-{{ arch() }}-linux.tar.gz" "{{ version }}" "{{ format }}"
