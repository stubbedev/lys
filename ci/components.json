    "login": {
      "depends": ["wm", "secrets", "packaging"],
      "package": true,
      "gates": ["vet", "lint", "no-fused", "test", "build"],
      "race": true,
      "vms": [
        ["login-vms-sessions", "login-vms-greetd"],
        ["login-vms-greeter"],
        ["login-vms-autologin"]
      ]
    },
    "settings": {
      "depends": ["wm", "packaging"],
      "package": true,
      "gates": ["vet", "lint", "no-fused", "test", "build"],
      "race": true,
      "shards": [
        [
          {
            "package": "./internal/settings",
            "tests": [
              "TestEveryLaidOutPageHoldsThePageChecks",
              "TestEveryPageBuilds",
              "TestEveryPageWithoutItsServicesSaysSoInOneCardState",
              "TestEveryShellRowSaysARefusedWriteInTheAppsWords",
              "TestEveryWMControlWritesOnlyWhatLysWMAccepts"
            ]
          }
        ]
      ]
    },
    "polkit": {
      "gates": ["vet", "lint", "test", "build"]
    },
    "power": {
      "depends": ["packaging"],
      "package": true,
      "gates": ["vet", "lint", "test", "build"],
      "race": true
    },
    "secrets": {
      "depends": ["packaging"],
      "package": true,
      "gates": ["vet", "lint", "test", "build"],
      "race": true
    },
    "splash": {
      "depends": ["wm", "login"],
      "gates": ["vet", "lint", "no-fused", "test", "build"],
      "jobs": [
        {
          "name": "initramfs-tools image",
          "runners": ["x86_64"],
          "run": "just splash::initramfs-tools",
          "after-build": true
        }
      ],
      "vms": [
        ["splash-vms-greeter"],
        ["splash-vms-luks"],
        ["splash-vms-luks-headless"],
        ["splash-vms-firmware"]
      ],
      "free-disk": true
    },
