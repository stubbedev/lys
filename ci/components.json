    "shell": {
      "depends": ["wm", "login", "secrets", "settings", "packaging"],
      "paths": ["docs/shell/config/"],
      "package": true,
      "gates": ["vet", "lint", "no-fused", "test", "schema-check", "dist"],
      "race": true,
      "shards": [
        ["./shell/bar", "./shell/dialogsurface", "./cava"],
        ["./shell/filechooser", "./shell/launcher", "./service/recorder", "./cmd/lys-shell"]
      ],
      "vms": [["shell-hyprland-vms"]]
