{
  "repository": {
    "paths": ["go.mod", "go.sum", "flake.nix", "flake.lock", "justfile", "nix/", "ci/", ".github/actions/", ".github/workflows/ci.yml", ".github/workflows/package.yml"],
    "affects-all": true,
    "jobs": [
      {
        "name": "tidy, flake and CI planner",
        "runners": ["x86_64"],
        "run": "just repository-check"
      }
    ]
  },
  "packaging": {},
  "lib": {
    "paths": ["docs/lib/xkb.md"],
    "gates": ["fmt-check", "vet", "lint", "no-fused", "test", "build"],
    "race": true,
    "jobs": [
      {
        "name": "GPU",
        "runners": ["x86_64"],
        "run": "just in lib gpu"
      },
      {
        "name": "headless",
        "runners": ["x86_64"],
        "run": "just in lib headless"
      }
    ]
  },
  "ui": {
    "paths": ["docs/ui/css.md"],
    "gates": ["fmt-check", "vet", "lint", "no-fused", "test", "build", "test-lysdebug", "atspi", "atspi-verify"],
    "race": true,
    "jobs": [
      {
        "name": "GPU",
        "runners": ["x86_64"],
        "run": "just in ui gpu"
      },
      {
        "name": "headless",
        "runners": ["x86_64"],
        "run": "just in ui headless"
      }
    ]
  },
  "desktop": {
    "gates": ["vet", "lint", "no-fused", "test", "build"],
    "race": true
  },
  "wm": {
    "depends": ["ui", "packaging"],
    "paths": ["docs/wm/actions.md", "docs/wm/shaders/"],
    "package": true,
    "gates": ["fmt-check", "vet", "lint", "no-fused", "test", "build", "vuln"],
    "race": true,
    "jobs": [
      {
        "name": "pacing, GLES",
        "runners": ["x86_64"],
        "run": "just in wm pace-gate gles"
      },
      {
        "name": "pacing, Vulkan",
        "runners": ["x86_64"],
        "run": "just in wm pace-gate vulkan"
      }
    ],
    "vms": ["wm-vms-desktop", "wm-vms-go-tests", "wm-vms-gpus", "wm-vms-share", "wm-vms-vkms", "wm-vms-xwayland-idea"]
  },
  "shell": {
    "depends": ["wm", "login", "secrets", "settings", "packaging"],
    "paths": ["docs/shell/config/"],
    "package": true,
    "gates": ["vet", "lint", "no-fused", "test", "schema-check", "dist"],
    "race": true,
    "vms": ["shell-hyprland-vms"]
  },
  "login": {
    "depends": ["wm", "secrets", "packaging"],
    "package": true,
    "gates": ["vet", "lint", "no-fused", "test", "build"],
    "race": true,
    "vms": ["login-vms-autologin", "login-vms-greetd", "login-vms-greeter", "login-vms-sessions"]
  },
  "settings": {
    "depends": ["wm", "packaging"],
    "package": true,
    "gates": ["vet", "lint", "no-fused", "test", "build"],
    "race": true
  },
  "polkit": {
    "gates": ["vet", "lint", "test", "build"]
  },
  "power": {
    "depends": ["packaging"],
    "package": true,
    "gates": ["vet", "lint", "test", "build"],
    "race": true
  },
  "secrets": {
    "depends": ["packaging"],
    "package": true,
    "gates": ["vet", "lint", "test", "build"],
    "race": true
  },
  "splash": {
    "depends": ["wm", "login"],
    "gates": ["vet", "lint", "no-fused", "test", "build"],
    "jobs": [
      {
        "name": "initramfs-tools image",
        "runners": ["x86_64"],
        "run": "just splash::initramfs-tools"
      }
    ],
    "vms": ["splash-vms-firmware", "splash-vms-greeter"],
    "free-disk": true
  },
  "desktop-vms": {
    "depends": ["lib", "polkit", "secrets", "settings", "shell"],
    "vms": ["desktop-vms-session", "desktop-vms-system"]
  }
}
