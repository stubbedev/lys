[Desktop Entry]
Type=Application
Name=Lys Viewer
GenericName=Picture, Video and Document Viewer
Comment=Show pictures, videos and documents
Exec=lys-viewer %U
Icon=lys-viewer
Terminal=false
Categories=Graphics;Viewer;
Keywords=picture;image;photo;video;movie;document;pdf;book;viewer;lys;
MimeType=application/epub+zip;application/pdf;application/vnd.amazon.mobi8-ebook;application/vnd.ms-htmlhelp;application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/x-fictionbook+xml;application/x-mobipocket-ebook;image/bmp;image/gif;image/heif;image/jpeg;image/jxl;image/png;image/tiff;image/webp;image/x-farbfeld;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-tga;video/matroska;video/mp4;video/webm;video/x-matroska;
StartupNotify=true
StartupWMClass=dev.stubbe.lys.viewer
