# lys-desktop dev tasks.

default:
    @just --list

# Every gate CI runs: vet, lint, no-fused, test, race, build.
check: plain race

# Every gate but the race detector, which CI runs as its own job.
plain: vet lint no-fused test build

vet:
    go vet ./...

lint:
    golangci-lint fmt --diff
    golangci-lint run

no-fused:
    no-fused

test *args:
    go test ${LYS_TEST_ARGS--shuffle=on} ./... {{ args }}

race:
    CGO_ENABLED=1 go test -race ${LYS_TEST_ARGS--shuffle=on} ./...

build:
    go build -o /dev/null ./...

fmt:
    golangci-lint fmt
