settings-share-picker-default-page = Pagina predefinita
    .description = Pagina mostrata all'apertura del selettore di condivisione schermo

settings-share-picker-hide-token-restore = Nascondi il token di ripristino
    .description = Nasconde la casella "consenti un token di ripristino"

settings-share-picker-width = Larghezza
    .description = Larghezza della finestra del selettore: un moltiplicatore del valore predefinito (1.0) o pixel (ad es. "1200px")

settings-share-picker-height = Altezza
    .description = Altezza della finestra del selettore: un moltiplicatore del valore predefinito (1.0) o pixel

settings-share-picker-resize-size = Risoluzione dell'anteprima
    .description = Riduce ogni fotogramma acquisito al massimo a questa altezza in pixel

settings-share-picker-widget-size = Altezza dell'immagine delle schede
    .description = Altezza dell'immagine di anteprima di ogni scheda: un moltiplicatore del valore predefinito (1.0) o pixel

settings-share-picker-windows-spacing = Spaziatura delle schede
    .description = Spaziatura tra le schede delle finestre: un moltiplicatore del valore predefinito (1.0) o pixel

settings-share-picker-windows-min-per-row = Minimo per riga
    .description = Numero minimo di schede di finestre per riga

settings-share-picker-windows-max-per-row = Massimo per riga
    .description = Numero massimo di schede di finestre per riga

settings-share-picker-outputs-spacing = Spaziatura delle schede
    .description = Spaziatura tra le schede delle uscite (applicata per lato): un moltiplicatore del valore predefinito (1.0) o pixel

settings-share-picker-outputs-show-label = Mostra le etichette delle uscite
    .description = Mostra l'etichetta con il nome dell'uscita sotto ogni scheda

settings-share-picker-outputs-respect-scaling = Rispetta il ridimensionamento
    .description = Ridimensiona le schede delle uscite in base alla loro scala frazionaria


