### lys-shell Configuration - RAM Module

## RAM Module Configuration

settings-modules-ram-poll-interval-ms = Intervallo di aggiornamento
    .description = Intervallo di aggiornamento in millisecondi

settings-modules-ram-format = Formato di visualizzazione
    .description = Stringa di formato con i segnaposto: {"{{ percent }}"}, {"{{ used_gib }}"}, {"{{ total_gib }}"}, {"{{ available_gib }}"}, {"{{ swap_percent }}"}, {"{{ swap_used_gib }}"}, {"{{ swap_total_gib }}"}

settings-modules-ram-icon-name = Nome dell'icona
    .description = Nome dell'icona simbolica

settings-modules-ram-border-show = Mostra il bordo
    .description = Mostra un bordo attorno al pulsante

settings-modules-ram-border-color = Colore del bordo
    .description = Token del colore del bordo

settings-modules-ram-icon-show = Mostra l'icona
    .description = Mostra l'icona del modulo

settings-modules-ram-tooltip = Mostra il suggerimento
    .description = Mostra lo stato del modulo in un suggerimento al passaggio del mouse

settings-modules-ram-icon-color = Colore dell'icona
    .description = Colore di primo piano dell'icona

settings-modules-ram-icon-bg-color = Sfondo dell'icona
    .description = Colore di sfondo del contenitore dell'icona

settings-modules-ram-label-show = Mostra l'etichetta
    .description = Mostra l'etichetta di testo

settings-modules-ram-label-color = Colore dell'etichetta
    .description = Colore del testo dell'etichetta

settings-modules-ram-label-max-length = Lunghezza massima dell'etichetta
    .description = Numero massimo di caratteri prima del troncamento

settings-modules-ram-button-bg-color = Sfondo del pulsante
    .description = Colore di sfondo del pulsante

settings-modules-ram-left-click = Clic sinistro
    .description = Comando della shell al clic sinistro

settings-modules-ram-right-click = Clic destro
    .description = Comando della shell al clic destro

settings-modules-ram-middle-click = Clic centrale
    .description = Comando della shell al clic centrale

settings-modules-ram-scroll-up = Scorrimento in alto
    .description = Comando della shell allo scorrimento in alto

settings-modules-ram-scroll-down = Scorrimento in basso
    .description = Comando della shell allo scorrimento in basso

## Format placeholders

settings-modules-ram-format-placeholder-percent = Utilizzo della memoria (0-100)

settings-modules-ram-format-placeholder-used-gib = Memoria usata in GiB

settings-modules-ram-format-placeholder-total-gib = Memoria totale in GiB

settings-modules-ram-format-placeholder-available-gib = Memoria disponibile in GiB

settings-modules-ram-format-placeholder-swap-percent = Utilizzo dello swap (0-100)

settings-modules-ram-format-placeholder-swap-used-gib = Swap usato in GiB

settings-modules-ram-format-placeholder-swap-total-gib = Swap totale in GiB
