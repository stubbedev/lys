settings-animations-enabled = Attivate
    .description = Anima la comparsa e la scomparsa dell'OSD, dei toast e delle notifiche, e applica una dissolvenza ai cambi di icona

settings-animations-duration = Durata
    .description = Durata dell'animazione in millisecondi

settings-animations-transition = Transizione
    .description = Stile di comparsa e scomparsa per l'OSD, i toast e le schede delle notifiche

settings-animations-enter = Transizione di comparsa
    .description = Transizione usata quando le superfici appaiono. Se non impostata, si usa Transizione

settings-animations-exit = Transizione di scomparsa
    .description = Transizione usata quando le superfici scompaiono. Se non impostata, Sollevamento

settings-animations-enter-duration = Durata della comparsa
    .description = Durata dell'animazione di comparsa in millisecondi. Se non impostata, si usa Durata

settings-animations-exit-duration = Durata della scomparsa
    .description = Durata dell'animazione di scomparsa in millisecondi. Se non impostata, si usa Durata

settings-animations-interaction-duration = Durata delle interazioni
    .description = Durata in ms degli effetti al passaggio del mouse e delle transizioni di pagina nei menu a discesa. Disattivando le animazioni vengono rimossi

settings-animations-ui-duration = Durata dell'interfaccia
    .description = Durata di base in ms delle micro-transizioni generali dell'interfaccia (passaggio del mouse, focus, dissolvenze di colore)

settings-animations-reduced-motion = Movimento ridotto
    .description = Sostituisce il movimento con dissolvenze qui e nelle app: nulla scorre, oscilla o rimbalza, e gli indicatori ciclici si fermano. Con lys-wm non ha effetto: imposta animations.reduced_motion nella sua configurazione

settings-animations-indicators = Indicatori
    .description = Esegue gli indicatori di stato ciclici: spinner, animazioni di ricerca, l'impulso di registrazione, il lampeggio dell'orologio

settings-animations-notifications = Notifiche
    .description = Animazione specifica per le schede popup delle notifiche
settings-animations-menu = Menu
    .description = Animazione specifica per menu, menu contestuali, elenchi a discesa e anteprime delle finestre

settings-animations-osd = OSD
    .description = Animazione specifica per l'OSD (volume/luminosità/interruttori)

settings-animations-dropdown = Menu a discesa
    .description = Animazione specifica per i menu a discesa dei widget della barra

settings-animations-share-picker = Selettore di condivisione
    .description = Animazione specifica per il selettore di condivisione schermo

settings-animations-wallpaper = Sfondo
    .description = Animazione specifica per la dissolvenza dello sfondo

settings-animations-power = Menu di alimentazione
    .description = Animazione specifica per il menu di alimentazione

settings-animations-dialog = Finestre di dialogo del portale
    .description = Animazione specifica per le finestre di dialogo del portale (richieste di accesso, account, scelta dell'app, installazione dall'avviatore)

settings-animations-file-chooser = Selettore file del portale
    .description = Animazione specifica per il selettore file del portale

settings-animations-print = Stampa del portale
    .description = Animazione specifica per la finestra di stampa del portale

settings-animations-lock = Schermata di blocco
    .description = Animazione specifica per la comparsa della schermata di blocco


## AnimationType variants
enum-animation-type-none = Nessuna
enum-animation-type-fade = Dissolvenza
enum-animation-type-slide-up = Scorri in alto
enum-animation-type-slide-down = Scorri in basso
enum-animation-type-slide-left = Scorri a sinistra
enum-animation-type-slide-right = Scorri a destra
enum-animation-type-swing-up = Oscilla in alto
enum-animation-type-swing-down = Oscilla in basso
enum-animation-type-swing-left = Oscilla a sinistra
enum-animation-type-swing-right = Oscilla a destra
enum-animation-type-bounce = Rimbalzo
enum-animation-type-genie = Genio
enum-animation-type-zoom = Zoom
enum-animation-type-rotate = Rotazione
enum-animation-type-flip = Capovolgimento
enum-animation-type-lift = Sollevamento
