settings-share-picker-default-page = Página predeterminada
    .description = Página que se muestra al abrir el selector de pantalla compartida

settings-share-picker-hide-token-restore = Ocultar el token de restauración
    .description = Oculta la casilla "permitir un token de restauración"

settings-share-picker-width = Anchura
    .description = Anchura de la ventana del selector: un multiplicador del valor predeterminado (1.0) o píxeles (p. ej. "1200px")

settings-share-picker-height = Altura
    .description = Altura de la ventana del selector: un multiplicador del valor predeterminado (1.0) o píxeles

settings-share-picker-resize-size = Resolución de la vista previa
    .description = Reduce cada fotograma capturado a como máximo esta altura en píxeles

settings-share-picker-widget-size = Altura de la imagen de las tarjetas
    .description = Altura de la imagen de vista previa de cada tarjeta: un multiplicador del valor predeterminado (1.0) o píxeles

settings-share-picker-windows-spacing = Espaciado de las tarjetas
    .description = Espacio entre las tarjetas de ventanas: un multiplicador del valor predeterminado (1.0) o píxeles

settings-share-picker-windows-min-per-row = Mínimo por fila
    .description = Mínimo de tarjetas de ventanas por fila

settings-share-picker-windows-max-per-row = Máximo por fila
    .description = Máximo de tarjetas de ventanas por fila

settings-share-picker-outputs-spacing = Espaciado de las tarjetas
    .description = Espacio entre las tarjetas de salidas (aplicado a cada lado): un multiplicador del valor predeterminado (1.0) o píxeles

settings-share-picker-outputs-show-label = Mostrar las etiquetas de las salidas
    .description = Muestra la etiqueta con el nombre de la salida bajo cada tarjeta de salida

settings-share-picker-outputs-respect-scaling = Respetar el escalado
    .description = Escala las tarjetas de salidas según su escala fraccionaria


## SharePickerPage variants
enum-share-picker-page-windows = Ventanas
enum-share-picker-page-outputs = Salidas
enum-share-picker-page-region = Región
