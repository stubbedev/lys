### lys-shell Configuration - Battery Module

## Battery Module Configuration

settings-modules-battery-level-icons = Iconos de nivel
    .description = Iconos que se muestran en los distintos niveles de carga, de vacía a llena

settings-modules-battery-charging-icon = Icono de carga
    .description = Icono que se muestra cuando la batería se está cargando

settings-modules-battery-alert-icon = Icono de alerta
    .description = Icono que se muestra cuando falta la batería o está en estado de error

settings-modules-battery-border-show = Mostrar el borde
    .description = Muestra un borde alrededor del botón

settings-modules-battery-border-color = Color del borde
    .description = Token de color del borde

settings-modules-battery-icon-show = Mostrar el icono
    .description = Muestra el icono del módulo

settings-modules-battery-tooltip = Mostrar descripción emergente
    .description = Muestra el estado del módulo en una descripción emergente al pasar el puntero

settings-modules-battery-icon-color = Color del icono
    .description = Color de primer plano del icono

settings-modules-battery-icon-bg-color = Fondo del icono
    .description = Color de fondo del contenedor del icono

settings-modules-battery-label-show = Mostrar la etiqueta
    .description = Muestra la etiqueta de porcentaje

settings-modules-battery-label-color = Color de la etiqueta
    .description = Color del texto de la etiqueta

settings-modules-battery-label-max-length = Longitud máxima de la etiqueta
    .description = Máximo de caracteres antes de truncar

settings-modules-battery-button-bg-color = Fondo del botón
    .description = Color de fondo del botón

settings-modules-battery-right-click = Clic derecho
    .description = Orden de shell al hacer clic derecho

settings-modules-battery-middle-click = Clic central
    .description = Orden de shell al hacer clic central

settings-modules-battery-scroll-up = Desplazar hacia arriba
    .description = Orden de shell al desplazar hacia arriba

settings-modules-battery-scroll-down = Desplazar hacia abajo
    .description = Orden de shell al desplazar hacia abajo

settings-modules-battery-format = Formato
    .description = Plantilla de la etiqueta de la batería (p. ej. {"{{"} percent {"}}"} %)

settings-modules-battery-left-click = Clic izquierdo
    .description = Acción al hacer clic izquierdo

settings-modules-battery-notify-low = Notificaciones de batería baja
    .description = Notifica cuando la batería o un periférico alcanzan el nivel bajo o crítico

settings-modules-battery-notify-charged-at = Notificación de carga completa
    .description = Notifica una vez cuando la carga alcanza este porcentaje (0 lo desactiva)

settings-modules-battery-app-nap = App Nap
    .description = Cuánto reposa cada app mientras no la ves

## Format placeholders

settings-modules-battery-format-placeholder-percent = Nivel de batería (0-100)

enum-nap-level-default = Reposo normal
enum-nap-level-never = Nunca reposar
enum-nap-level-efficiency-cores = Núcleos de eficiencia
enum-nap-level-frozen = Congelada con batería
