### lys-shell Configuration - Microphone Module

## Microphone Module Configuration

settings-modules-microphone-icon-active = Icono de activo
    .description = Icono que se muestra cuando el micrófono está activo (sin silenciar)

settings-modules-microphone-icon-muted = Icono de silenciado
    .description = Icono que se muestra cuando el micrófono está silenciado

settings-modules-microphone-border-show = Mostrar el borde
    .description = Muestra un borde alrededor del botón

settings-modules-microphone-border-color = Color del borde
    .description = Token de color del borde

settings-modules-microphone-icon-show = Mostrar el icono
    .description = Muestra el icono del módulo

settings-modules-microphone-tooltip = Mostrar descripción emergente
    .description = Muestra el estado del módulo en una descripción emergente al pasar el puntero

settings-modules-microphone-icon-color = Color del icono
    .description = Color de primer plano del icono

settings-modules-microphone-icon-bg-color = Fondo del icono
    .description = Color de fondo del contenedor del icono

settings-modules-microphone-label-show = Mostrar la etiqueta
    .description = Muestra la etiqueta de porcentaje

settings-modules-microphone-label-color = Color de la etiqueta
    .description = Color del texto de la etiqueta

settings-modules-microphone-label-max-length = Longitud máxima de la etiqueta
    .description = Máximo de caracteres antes de truncar

settings-modules-microphone-button-bg-color = Fondo del botón
    .description = Color de fondo del botón

settings-modules-microphone-left-click = Clic izquierdo
    .description = Orden de shell al hacer clic izquierdo

settings-modules-microphone-right-click = Clic derecho
    .description = Orden de shell al hacer clic derecho

settings-modules-microphone-middle-click = Clic central
    .description = Orden de shell al hacer clic central

settings-modules-microphone-scroll-up = Desplazar hacia arriba
    .description = Acción al desplazar hacia arriba

settings-modules-microphone-scroll-down = Desplazar hacia abajo
    .description = Acción al desplazar hacia abajo

settings-modules-microphone-thresholds = Umbrales
    .description = Umbrales de color que cambian según el nivel del valor
