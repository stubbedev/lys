### lys-shell Configuration - Bluetooth Module

## Bluetooth Module Configuration

settings-modules-bluetooth-disabled-icon = Icono de desactivado
    .description = Icono cuando Bluetooth está desactivado o no disponible

settings-modules-bluetooth-disconnected-icon = Icono de desconectado
    .description = Icono cuando Bluetooth está activado pero no hay dispositivos conectados

settings-modules-bluetooth-connected-icon = Icono de conectado
    .description = Icono cuando hay dispositivos conectados

settings-modules-bluetooth-searching-icon = Icono de búsqueda
    .description = Icono mientras se buscan dispositivos

settings-modules-bluetooth-border-show = Mostrar el borde
    .description = Muestra un borde alrededor del botón

settings-modules-bluetooth-border-color = Color del borde
    .description = Token de color del borde

settings-modules-bluetooth-icon-show = Mostrar el icono
    .description = Muestra el icono del módulo

settings-modules-bluetooth-tooltip = Mostrar descripción emergente
    .description = Muestra el estado del módulo en una descripción emergente al pasar el puntero

settings-modules-bluetooth-icon-color = Color del icono
    .description = Color de primer plano del icono

settings-modules-bluetooth-icon-bg-color = Fondo del icono
    .description = Color de fondo del contenedor del icono

settings-modules-bluetooth-label-show = Mostrar la etiqueta
    .description = Muestra la etiqueta de conexión

settings-modules-bluetooth-label-color = Color de la etiqueta
    .description = Color del texto de la etiqueta

settings-modules-bluetooth-label-max-length = Longitud máxima de la etiqueta
    .description = Máximo de caracteres antes de truncar

settings-modules-bluetooth-button-bg-color = Fondo del botón
    .description = Color de fondo del botón

settings-modules-bluetooth-right-click = Clic derecho
    .description = Orden de shell al hacer clic derecho

settings-modules-bluetooth-middle-click = Clic central
    .description = Orden de shell al hacer clic central

settings-modules-bluetooth-scroll-up = Desplazar hacia arriba
    .description = Orden de shell al desplazar hacia arriba

settings-modules-bluetooth-scroll-down = Desplazar hacia abajo
    .description = Orden de shell al desplazar hacia abajo

settings-modules-bluetooth-left-click = Clic izquierdo
    .description = Acción al hacer clic izquierdo
