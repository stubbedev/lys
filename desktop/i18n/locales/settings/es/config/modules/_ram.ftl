### lys-shell Configuration - RAM Module

## RAM Module Configuration

settings-modules-ram-poll-interval-ms = Intervalo de sondeo
    .description = Intervalo de sondeo en milisegundos

settings-modules-ram-format = Formato de visualización
    .description = Cadena de formato con marcadores: {"{{ percent }}"}, {"{{ used_gib }}"}, {"{{ total_gib }}"}, {"{{ available_gib }}"}, {"{{ swap_percent }}"}, {"{{ swap_used_gib }}"}, {"{{ swap_total_gib }}"}

settings-modules-ram-icon-name = Nombre del icono
    .description = Nombre del icono simbólico

settings-modules-ram-border-show = Mostrar el borde
    .description = Muestra un borde alrededor del botón

settings-modules-ram-border-color = Color del borde
    .description = Token de color del borde

settings-modules-ram-icon-show = Mostrar el icono
    .description = Muestra el icono del módulo

settings-modules-ram-tooltip = Mostrar descripción emergente
    .description = Muestra el estado del módulo en una descripción emergente al pasar el puntero

settings-modules-ram-icon-color = Color del icono
    .description = Color de primer plano del icono

settings-modules-ram-icon-bg-color = Fondo del icono
    .description = Color de fondo del contenedor del icono

settings-modules-ram-label-show = Mostrar la etiqueta
    .description = Muestra la etiqueta de texto

settings-modules-ram-label-color = Color de la etiqueta
    .description = Color del texto de la etiqueta

settings-modules-ram-label-max-length = Longitud máxima de la etiqueta
    .description = Máximo de caracteres antes de truncar

settings-modules-ram-button-bg-color = Fondo del botón
    .description = Color de fondo del botón

settings-modules-ram-left-click = Clic izquierdo
    .description = Orden de shell al hacer clic izquierdo

settings-modules-ram-right-click = Clic derecho
    .description = Orden de shell al hacer clic derecho

settings-modules-ram-middle-click = Clic central
    .description = Orden de shell al hacer clic central

settings-modules-ram-scroll-up = Desplazar hacia arriba
    .description = Orden de shell al desplazar hacia arriba

settings-modules-ram-scroll-down = Desplazar hacia abajo
    .description = Orden de shell al desplazar hacia abajo

settings-modules-ram-thresholds = Umbrales
    .description = Umbrales de color que cambian según el nivel del valor

## Format placeholders

settings-modules-ram-format-placeholder-percent = Uso de memoria (0-100)

settings-modules-ram-format-placeholder-used-gib = Memoria usada en GiB

settings-modules-ram-format-placeholder-total-gib = Memoria total en GiB

settings-modules-ram-format-placeholder-available-gib = Memoria disponible en GiB

settings-modules-ram-format-placeholder-swap-percent = Uso de intercambio (0-100)

settings-modules-ram-format-placeholder-swap-used-gib = Intercambio usado en GiB

settings-modules-ram-format-placeholder-swap-total-gib = Intercambio total en GiB
