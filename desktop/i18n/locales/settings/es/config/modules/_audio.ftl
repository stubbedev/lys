### lys-shell Configuration - Audio Module

## Audio Module Configuration

settings-modules-audio-speaker-icons = Iconos del altavoz
    .description = Iconos del altavoz para los niveles de volumen, de bajo a máximo

settings-modules-audio-speaker-icon-muted = Icono de altavoz silenciado
    .description = Icono del altavoz que se muestra mientras la salida está silenciada

settings-modules-audio-mic-icon = Icono del micrófono
    .description = Icono del micrófono que se muestra mientras la entrada está activa

settings-modules-audio-mic-icon-muted = Icono de micrófono silenciado
    .description = Icono del micrófono que se muestra mientras la entrada está silenciada

settings-modules-audio-mic-hide-when-idle = Ocultar el micrófono en reposo
    .description = Muestra el icono del micrófono solo mientras una aplicación graba el micrófono

settings-modules-audio-capture-camera-icon = Icono de la cámara
    .description = Icono que se muestra mientras una aplicación tiene una cámara abierta

settings-modules-audio-capture-screen-icon = Icono de la pantalla
    .description = Icono que se muestra mientras una aplicación comparte la pantalla

settings-modules-audio-capture-color = Color de captura
    .description = Color del icono del micrófono mientras una aplicación lo graba, y de los iconos de la cámara y la pantalla

settings-modules-audio-border-show = Mostrar el borde
    .description = Muestra un borde alrededor del botón

settings-modules-audio-border-color = Color del borde
    .description = Token de color del borde

settings-modules-audio-icon-show = Mostrar el icono
    .description = Muestra el icono del altavoz

settings-modules-audio-tooltip = Mostrar descripción emergente
    .description = Muestra el estado del módulo en una descripción emergente al pasar el puntero

settings-modules-audio-icon-color = Color del icono
    .description = Color de primer plano del icono

settings-modules-audio-icon-bg-color = Fondo del icono
    .description = Color de fondo del contenedor del icono

settings-modules-audio-label-show = Mostrar la etiqueta
    .description = Muestra la etiqueta

settings-modules-audio-label-color = Color de la etiqueta
    .description = Color del texto de la etiqueta

settings-modules-audio-format = Formato
    .description = Plantilla de la etiqueta (p. ej. {"{{"} percent {"}}"} %)

settings-modules-audio-label-max-length = Longitud máxima de la etiqueta
    .description = Máximo de caracteres antes de truncar

settings-modules-audio-button-bg-color = Fondo del botón
    .description = Color de fondo del botón

settings-modules-audio-left-click = Clic izquierdo
    .description = Acción al hacer clic izquierdo

settings-modules-audio-right-click = Clic derecho
    .description = Acción al hacer clic derecho

settings-modules-audio-middle-click = Clic central
    .description = Acción al hacer clic central

settings-modules-audio-scroll-up = Desplazar hacia arriba
    .description = Acción al desplazar hacia arriba

settings-modules-audio-scroll-down = Desplazar hacia abajo
    .description = Acción al desplazar hacia abajo

settings-modules-audio-dropdown-app-icons = Iconos de aplicaciones en el desplegable
    .description = Muestra los iconos de las aplicaciones en el desplegable de audio

settings-modules-audio-thresholds = Umbrales
    .description = Umbrales de color que cambian con el volumen del altavoz

## AppIconSource variants
enum-app-icon-source-mapped = Asignado
enum-app-icon-source-native = Nativo


## Format placeholders

settings-modules-audio-format-placeholder-percent = Volumen del altavoz (0-100)
settings-modules-audio-format-placeholder-mic-percent = Volumen del micrófono (0-100), vacío sin micrófono
