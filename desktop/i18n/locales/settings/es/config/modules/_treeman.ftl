### lys-shell Configuration - Treeman Module

## Treeman Module Configuration

settings-modules-treeman-format = Formato de la etiqueta
    .description = Cadena de formato con marcadores: {"{{ total }}"}, {"{{ stable }}"}, {"{{ up }}"}, {"{{ down }}"}, {"{{ failed }}"}

settings-modules-treeman-icon-name = Icono
    .description = Icono del módulo (se muestra cuando todos los árboles de trabajo están listos y en reposo)

settings-modules-treeman-icon-preparing = Icono de preparación
    .description = Icono que se muestra mientras se prepara algún árbol de trabajo

settings-modules-treeman-icon-tearing-down = Icono de desmontaje
    .description = Icono que se muestra mientras se desmonta algún árbol de trabajo

settings-modules-treeman-icon-failed = Icono de fallo
    .description = Icono que se muestra cuando la última finalización de algún árbol de trabajo ha dado error

settings-modules-treeman-hide-if-empty = Ocultar si está vacío
    .description = Contrae el módulo cuando no hay árboles de trabajo activos

settings-modules-treeman-border-show = Mostrar el borde
    .description = Muestra un borde alrededor del botón

settings-modules-treeman-border-color = Color del borde
    .description = Token de color del borde

settings-modules-treeman-icon-show = Mostrar el icono
    .description = Muestra el icono del módulo

settings-modules-treeman-tooltip = Mostrar descripción emergente
    .description = Muestra el estado del módulo en una descripción emergente al pasar el puntero

settings-modules-treeman-icon-color = Color del icono
    .description = Color de primer plano del icono

settings-modules-treeman-icon-bg-color = Fondo del icono
    .description = Color de fondo del contenedor del icono

settings-modules-treeman-label-show = Mostrar la etiqueta
    .description = Muestra la etiqueta con el recuento

settings-modules-treeman-label-color = Color de la etiqueta
    .description = Color del texto de la etiqueta

settings-modules-treeman-label-max-length = Longitud máxima de la etiqueta
    .description = Máximo de caracteres antes de truncar

settings-modules-treeman-button-bg-color = Fondo del botón
    .description = Color de fondo del botón

settings-modules-treeman-left-click = Clic izquierdo
    .description = Acción al hacer clic izquierdo

settings-modules-treeman-right-click = Clic derecho
    .description = Acción al hacer clic derecho

settings-modules-treeman-middle-click = Clic central
    .description = Acción al hacer clic central

settings-modules-treeman-scroll-up = Desplazar hacia arriba
    .description = Acción al desplazar hacia arriba

settings-modules-treeman-scroll-down = Desplazar hacia abajo
    .description = Acción al desplazar hacia abajo

## Format placeholders

settings-modules-treeman-format-placeholder-total = Total de árboles de trabajo activos

settings-modules-treeman-format-placeholder-stable = Árboles de trabajo en estado listo

settings-modules-treeman-format-placeholder-up = Árboles de trabajo en preparación

settings-modules-treeman-format-placeholder-down = Árboles de trabajo en desmontaje

settings-modules-treeman-format-placeholder-failed = Árboles de trabajo cuya última finalización ha dado error
