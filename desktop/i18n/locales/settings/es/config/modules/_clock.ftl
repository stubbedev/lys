### lys-shell Configuration - Clock Module

## Clock Module Configuration

settings-modules-clock-format = Formato de la hora
    .description = Cómo se muestra la hora en la barra

settings-modules-clock-icon-name = Nombre del icono
    .description = Nombre del icono simbólico

settings-modules-clock-border-show = Mostrar el borde
    .description = Muestra un borde alrededor del botón

settings-modules-clock-border-color = Color del borde
    .description = Token de color del borde

settings-modules-clock-icon-show = Mostrar el icono
    .description = Muestra el icono del módulo

settings-modules-clock-tooltip = Mostrar descripción emergente
    .description = Muestra el estado del módulo en una descripción emergente al pasar el puntero

settings-modules-clock-icon-color = Color del icono
    .description = Color de primer plano del icono

settings-modules-clock-icon-bg-color = Fondo del icono
    .description = Color de fondo del contenedor del icono

settings-modules-clock-label-show = Mostrar la etiqueta
    .description = Muestra la etiqueta de texto

settings-modules-clock-label-color = Color de la etiqueta
    .description = Color del texto de la etiqueta

settings-modules-clock-label-max-length = Longitud máxima de la etiqueta
    .description = Caracteres que muestra la etiqueta antes de recortarse; 0 no la recorta nunca

settings-modules-clock-button-bg-color = Fondo del botón
    .description = Color de fondo del botón

settings-modules-clock-left-click = Clic izquierdo
    .description = Orden de shell al hacer clic izquierdo

settings-modules-clock-right-click = Clic derecho
    .description = Orden de shell al hacer clic derecho

settings-modules-clock-middle-click = Clic central
    .description = Orden de shell al hacer clic central

settings-modules-clock-scroll-up = Desplazar hacia arriba
    .description = Orden de shell al desplazar hacia arriba

settings-modules-clock-scroll-down = Desplazar hacia abajo
    .description = Orden de shell al desplazar hacia abajo

settings-modules-clock-dropdown-show-seconds = Mostrar los segundos
    .description = Muestra los segundos en el reloj del desplegable del calendario

settings-modules-clock-calendar-weekday-start = Inicio de la semana del calendario
    .description = Primer día de la semana en el desplegable del calendario

## WeekStart variants
enum-week-start-auto = Según la región
enum-week-start-monday = Lunes
enum-week-start-tuesday = Martes
enum-week-start-wednesday = Miércoles
enum-week-start-thursday = Jueves
enum-week-start-friday = Viernes
enum-week-start-saturday = Sábado
enum-week-start-sunday = Domingo

settings-modules-clock-calendars = Calendarios
    .description = Carpetas vdir de archivos .ics (vdirsyncer, khal) cuyos eventos muestra el desplegable del calendario
