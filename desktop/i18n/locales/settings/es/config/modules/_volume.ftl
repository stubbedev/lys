### lys-shell Configuration - Volume Module

## Volume Module Configuration

settings-modules-volume-level-icons = Iconos de nivel
    .description = Iconos que se muestran en los distintos porcentajes de volumen, de silenciado a máximo

settings-modules-volume-muted-icon = Icono de silenciado
    .description = Icono que se muestra cuando la salida de audio está silenciada

settings-modules-volume-border-show = Mostrar el borde
    .description = Muestra un borde alrededor del botón

settings-modules-volume-border-color = Color del borde
    .description = Token de color del borde

settings-modules-volume-icon-show = Mostrar el icono
    .description = Muestra el icono del módulo

settings-modules-volume-tooltip = Mostrar descripción emergente
    .description = Muestra el estado del módulo en una descripción emergente al pasar el puntero

settings-modules-volume-icon-color = Color del icono
    .description = Color de primer plano del icono

settings-modules-volume-icon-bg-color = Fondo del icono
    .description = Color de fondo del contenedor del icono

settings-modules-volume-label-show = Mostrar la etiqueta
    .description = Muestra la etiqueta de porcentaje

settings-modules-volume-label-color = Color de la etiqueta
    .description = Color del texto de la etiqueta

settings-modules-volume-label-max-length = Longitud máxima de la etiqueta
    .description = Máximo de caracteres antes de truncar

settings-modules-volume-button-bg-color = Fondo del botón
    .description = Color de fondo del botón

settings-modules-volume-right-click = Clic derecho
    .description = Orden de shell al hacer clic derecho

settings-modules-volume-middle-click = Clic central
    .description = Orden de shell al hacer clic central

settings-modules-volume-scroll-up = Desplazar hacia arriba
    .description = Acción al desplazar hacia arriba

settings-modules-volume-scroll-down = Desplazar hacia abajo
    .description = Acción al desplazar hacia abajo

settings-modules-volume-format = Formato
    .description = Plantilla de la etiqueta del volumen (p. ej. {"{{"} percent {"}}"} %)

settings-modules-volume-left-click = Clic izquierdo
    .description = Acción al hacer clic izquierdo

settings-modules-volume-dropdown-app-icons = Iconos de aplicaciones en el desplegable
    .description = Muestra los iconos de las aplicaciones en el desplegable de audio

settings-modules-volume-thresholds = Umbrales
    .description = Umbrales de color que cambian según el nivel del valor

settings-modules-volume-icon-muted = Icono de silenciado
    .description = Icono que se muestra cuando el volumen está silenciado

