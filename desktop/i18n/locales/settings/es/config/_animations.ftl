settings-animations-enabled = Activadas
    .description = Anima la entrada y salida del OSD, los avisos y las notificaciones, y funde los cambios de iconos

settings-animations-duration = Duración
    .description = Duración de la animación en milisegundos

settings-animations-transition = Transición
    .description = Estilo de entrada y salida del OSD, los avisos y las tarjetas de notificación

settings-animations-enter = Transición de entrada
    .description = Transición usada cuando aparecen las superficies. Sin definir, se usa Transición

settings-animations-exit = Transición de salida
    .description = Transición usada cuando desaparecen las superficies. Sin definir, se usa Transición

settings-animations-enter-duration = Duración de entrada
    .description = Duración de la animación de entrada en milisegundos. Sin definir, se usa Duración

settings-animations-exit-duration = Duración de salida
    .description = Duración de la animación de salida en milisegundos. Sin definir, se usa Duración

settings-animations-interaction-duration = Duración de interacción
    .description = Duración en ms de las transiciones al pasar el puntero y de página dentro de los desplegables. Desactivar las animaciones las elimina

settings-animations-ui-duration = Duración de la interfaz
    .description = Duración base en ms de las microtransiciones generales de la interfaz (puntero encima, foco, fundidos de color)

settings-animations-reduced-motion = Movimiento reducido
    .description = Sustituye el movimiento por fundidos aquí y en las aplicaciones: nada se desliza, oscila ni rebota, y los indicadores en bucle se detienen. Con lys-wm no tiene efecto: establezca animations.reduced_motion en su configuración

settings-animations-indicators = Indicadores
    .description = Ejecuta los indicadores de estado en bucle: ruedas de espera, animaciones de búsqueda, el pulso de grabación, el parpadeo del reloj

settings-animations-notifications = Notificaciones
    .description = Animación específica para las tarjetas emergentes de notificación
settings-animations-menu = Menús
    .description = Animación propia para menús, menús contextuales, listas desplegables y vistas previas de ventanas

settings-animations-osd = OSD
    .description = Animación específica para el OSD (volumen/brillo/conmutadores)

settings-animations-dropdown = Desplegable
    .description = Animación específica para los desplegables de los widgets de la barra

settings-animations-share-picker = Selector de pantalla compartida
    .description = Animación específica para la superposición del selector de pantalla compartida

settings-animations-wallpaper = Fondo de escritorio
    .description = Animación específica para el fundido del fondo de escritorio

settings-animations-power = Menú de energía
    .description = Animación específica para la superposición del menú de energía

settings-animations-dialog = Diálogo del portal
    .description = Animación específica para los diálogos del portal (solicitudes de acceso, cuenta, selector de aplicaciones e instalación desde el lanzador)

settings-animations-file-chooser = Selector de archivos del portal
    .description = Animación específica para la superficie del selector de archivos del portal

settings-animations-print = Impresión del portal
    .description = Animación específica para la superficie de impresión del portal

settings-animations-lock = Pantalla de bloqueo
    .description = Animación específica para la aparición de la pantalla de bloqueo


## AnimationType variants
enum-animation-type-none = Ninguna
enum-animation-type-fade = Fundido
enum-animation-type-slide-up = Deslizar hacia arriba
enum-animation-type-slide-down = Deslizar hacia abajo
enum-animation-type-slide-left = Deslizar a la izquierda
enum-animation-type-slide-right = Deslizar a la derecha
enum-animation-type-swing-up = Balancear hacia arriba
enum-animation-type-swing-down = Balancear hacia abajo
enum-animation-type-swing-left = Balancear a la izquierda
enum-animation-type-swing-right = Balancear a la derecha
enum-animation-type-bounce = Rebote
enum-animation-type-genie = Genio
enum-animation-type-zoom = Zoom
enum-animation-type-rotate = Rotación
enum-animation-type-flip = Volteo
