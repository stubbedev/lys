settings-portal-screen-cast-reminder-days = Screen-Share Reminder
    .description = How long an app may keep sharing your screen before you are asked again whether to keep allowing it

settings-portal-lockdown-disable-printing = Block Printing
    .description = Refuse every app's request to print

settings-portal-lockdown-disable-save-to-disk = Block Saving Files
    .description = Refuse saving files through the file chooser

settings-portal-lockdown-disable-application-handlers = Block Opening in Other Apps
    .description = Refuse opening links and files in other applications

settings-portal-lockdown-disable-location = Block Location
    .description = Refuse every app's request for your location

settings-portal-lockdown-disable-camera = Block Camera
    .description = Refuse every app's request for the camera

settings-portal-lockdown-disable-microphone = Block Microphone
    .description = Refuse every app's request for the microphone

settings-portal-lockdown-disable-sound-output = Block Sound Output
    .description = Refuse sound output to every app

settings-portal-dynamic-launcher-install-token-apps = Trusted Installers
    .description = Apps that add launchers to the app list without asking, such as a software center
