settings-modules-notifications-blocklist = Lista de bloqueio
    .description = Padrões glob de nomes de aplicações cujas notificações são bloqueadas

settings-modules-notifications-icon-source = Origem dos ícones
    .description = Como os ícones das notificações são resolvidos

settings-modules-notifications-history-memory = Histórico em memória
    .description = Notificações mais recentes mantidas em memória; as mais antigas são carregadas do disco ao deslocar

settings-modules-notifications-history-stored = Histórico em disco
    .description = Notificações mantidas em disco; as mais antigas são eliminadas a partir deste número

settings-modules-notifications-popup-position = Posição das notificações
    .description = Canto do ecrã onde as notificações aparecem

settings-modules-notifications-popup-max-visible = Máximo visível
    .description = Número máximo de notificações mostradas em simultâneo antes de empilhar

settings-modules-notifications-popup-stacking-order = Ordem de empilhamento
    .description = Se as novas notificações aparecem acima ou abaixo das existentes

settings-modules-notifications-popup-stack = Empilhamento
    .description = Que notificações se recolhem numa pilha que se abre em leque ao passar o rato

settings-modules-notifications-popup-opacity = Opacidade em repouso
    .description = Opacidade da superfície fosca de uma notificação enquanto o ponteiro está noutro lado

settings-modules-notifications-popup-margin-x = Margem horizontal
    .description = Distância à margem esquerda/direita do ecrã

settings-modules-notifications-popup-margin-y = Margem vertical
    .description = Distância à margem superior/inferior do ecrã

settings-modules-notifications-popup-gap = Espaço entre notificações
    .description = Espaçamento entre notificações empilhadas

settings-modules-notifications-popup-monitor = Monitor das notificações
    .description = Que monitor mostra as notificações: "primary" ou um conector como "DP-1"

settings-modules-notifications-popup-layer = Camada das notificações
    .description = Camada layer-shell em que as notificações são colocadas. O modo de tearing despromove overlay para top.

settings-modules-notifications-popup-duration = Dispensar automaticamente
    .description = Quanto tempo as notificações ficam visíveis antes de fechar (ms)

settings-modules-notifications-popup-hover-pause = Pausar ao passar o rato
    .description = Parar o temporizador de dispensa automática enquanto o rato está sobre uma notificação

settings-modules-notifications-popup-close-behavior = Comportamento ao fechar
    .description = O que acontece quando fecha uma notificação (dispensar ou marcar como lida)

settings-modules-notifications-popup-urgency-bar = Barra de urgência
    .description = Mostrar uma barra colorida nas notificações que atingem um nível mínimo de urgência

settings-modules-notifications-sounds = Sons
    .description = Que notificações tocam um som; silenciosas em Não incomodar, durante a partilha de ecrã e com o som desativado

settings-modules-notifications-sound-default = Som predefinido
    .description = Nome do som do tema que uma notificação sem som próprio toca

settings-modules-notifications-sound-mute-apps = Aplicações silenciosas
    .description = Globs de nomes de aplicações cujas notificações nunca tocam um som
settings-modules-notifications-sound-volume = Volume do som
    .description = Volume dos sons de notificação, como proporção do som tal como foi gravado
