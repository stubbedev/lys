settings-wallpaper-wallpaper = Imagem de fundo
    .description = Um único ficheiro de imagem a usar em todos os monitores (deixe vazio para rotação / por monitor)

settings-wallpaper-fit-mode = Escala
    .description = Como a imagem de fundo é ajustada ao ecrã (fill, fit, center, stretch)

settings-wallpaper-cycling-directory = Pasta de rotação
    .description = Pasta de imagens a percorrer em rotação; defina-a para ativar a rotação, deixe vazia para desativar

settings-wallpaper-cycling-options = Opções de rotação
    .description = Ordem, intervalo e comportamento com vários monitores durante a rotação

settings-wallpaper-cycling-mode = Modo de rotação
    .description = Ordem de rotação das imagens de fundo (sequencial ou aleatória)

settings-wallpaper-cycling-interval-mins = Intervalo de rotação
    .description = Tempo entre mudanças de imagem de fundo em minutos

settings-wallpaper-cycling-same-image = Mesma imagem em todos os monitores
    .description = Mostrar a mesma imagem de fundo em rotação em todos os monitores (só afeta o modo aleatório)

settings-wallpaper-picker-directories = Pastas do seletor
    .description = Pastas de onde o seletor de imagens de fundo lista imagens (vazio: a pasta de rotação e Pictures/Wallpapers)

settings-wallpaper-oled-dim = Escurecer em OLED na bateria
    .description = Escurece a imagem de fundo em ecrãs OLED na bateria, onde os píxeis escuros gastam menos energia

settings-wallpaper-monitors = Imagens de fundo por monitor
    .description = Atribuições de imagem de fundo por monitor


enum-fit-mode-fill = Preencher
enum-fit-mode-fit = Ajustar
enum-fit-mode-center = Centrar
enum-fit-mode-stretch = Esticar

enum-cycling-mode-sequential = Sequencial
enum-cycling-mode-shuffle = Aleatório
