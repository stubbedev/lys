settings-dock-enabled = Mostrar doca
    .description = Mostrar a doca de aplicações afixadas e janelas abertas

settings-dock-monitors = Monitores
    .description = Saídas que mostram a doca, pelo nome do conector, ou * para todas as saídas

settings-dock-edge = Margem
    .description = Margem do ecrã onde a doca fica

settings-dock-icon-size = Tamanho dos ícones
    .description = Tamanho do ícone de cada aplicação

settings-dock-auto-hide = Ocultar automaticamente
    .description = Ocultar a doca enquanto uma janela a cobre e revelá-la na margem do ecrã; não reserva espaço

settings-dock-auto-hide-delay-ms = Atraso de ocultação
    .description = Quanto tempo a doca permanece depois de o ponteiro a deixar ou de uma janela a cobrir, em milissegundos

settings-dock-hover-zoom = Ampliar ao passar o rato
    .description = Aumentar o ícone sob o ponteiro, e os vizinhos para metade

settings-dock-hover-zoom-size = Tamanho da ampliação
    .description = Tamanho até ao qual o ícone da aplicação sob o ponteiro cresce

settings-dock-pinned = Aplicações afixadas
    .description = Aplicações sempre na doca, pelo id da entrada de ambiente de trabalho

settings-dock-icon = Ícone alternativo
    .description = Ícone para uma aplicação sem ícone na entrada de ambiente de trabalho

enum-dock-edge-bottom = Fundo
enum-dock-edge-left = Esquerda
enum-dock-edge-right = Direita
