settings-clipboard-history-mib = Tamanho do histórico
    .description = Memória máxima do histórico da área de transferência, em MiB; as entradas mais antigas são esquecidas primeiro

settings-clipboard-pinned-mib = Tamanho dos fixados
    .description = Tamanho máximo das entradas fixadas, em MiB; acima disso, fixar é recusado

settings-clipboard-persist = Manter o histórico
    .description = Manter o histórico da área de transferência entre reinícios; as seleções marcadas como secretas nunca são guardadas
