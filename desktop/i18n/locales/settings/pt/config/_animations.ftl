settings-animations-enabled = Ativadas
    .description = Animar a entrada/saída do OSD, dos avisos e das notificações, e esbater as mudanças de ícone

settings-animations-duration = Duração
    .description = Duração da animação em milissegundos

settings-animations-transition = Transição
    .description = Estilo de entrada/saída do OSD, dos avisos e dos cartões de notificação

settings-animations-enter = Transição de entrada
    .description = Transição usada quando as superfícies aparecem. Se não estiver definida, usa Transição

settings-animations-exit = Transição de saída
    .description = Transição usada quando as superfícies desaparecem. Se não estiver definida, usa Transição

settings-animations-enter-duration = Duração da entrada
    .description = Duração da animação de entrada em milissegundos. Se não estiver definida, usa Duração

settings-animations-exit-duration = Duração da saída
    .description = Duração da animação de saída em milissegundos. Se não estiver definida, usa Duração

settings-animations-interaction-duration = Duração da interação
    .description = Duração em ms das transições de passagem do rato e de página dentro dos menus pendentes. Desativar as animações remove-as

settings-animations-ui-duration = Duração da interface
    .description = Duração base em ms das microtransições gerais da interface (passagem do rato, foco, esbatimento de cores)

settings-animations-reduced-motion = Movimento reduzido
    .description = Substituir o movimento por esbatimentos aqui e nas aplicações: nada desliza, balança ou salta, e os indicadores em ciclo param. No lys-wm não tem efeito: defina animations.reduced_motion na configuração dele

settings-animations-indicators = Indicadores
    .description = Executar os indicadores de estado em ciclo: rodas de espera, animações de procura, o pulso de gravação, o piscar do relógio

settings-animations-notifications = Notificações
    .description = Substituição da animação para os cartões de notificação
settings-animations-menu = Menus
    .description = Animação própria para menus, menus de contexto, listas pendentes e pré-visualizações de janelas

settings-animations-osd = OSD
    .description = Substituição da animação para o OSD (volume/brilho/alternância)

settings-animations-dropdown = Menu pendente
    .description = Substituição da animação para os menus pendentes dos widgets da barra

settings-animations-share-picker = Seletor de partilha
    .description = Substituição da animação para a sobreposição do seletor de partilha de ecrã

settings-animations-wallpaper = Imagem de fundo
    .description = Substituição da animação para o esbatimento da imagem de fundo

settings-animations-power = Menu de energia
    .description = Substituição da animação para a sobreposição do menu de energia

settings-animations-dialog = Diálogo do portal
    .description = Substituição da animação para os diálogos do portal (pedidos de acesso/conta/escolha de aplicação/instalação no lançador)

settings-animations-file-chooser = Seletor de ficheiros do portal
    .description = Substituição da animação para a superfície do seletor de ficheiros do portal

settings-animations-print = Impressão do portal
    .description = Substituição da animação para a superfície de impressão do portal

settings-animations-lock = Ecrã de bloqueio
    .description = Substituição da animação para o aparecimento do ecrã de bloqueio


enum-animation-type-none = Nenhuma
enum-animation-type-fade = Esbater
enum-animation-type-slide-up = Deslizar para cima
enum-animation-type-slide-down = Deslizar para baixo
enum-animation-type-slide-left = Deslizar para a esquerda
enum-animation-type-slide-right = Deslizar para a direita
enum-animation-type-swing-up = Balançar para cima
enum-animation-type-swing-down = Balançar para baixo
enum-animation-type-swing-left = Balançar para a esquerda
enum-animation-type-swing-right = Balançar para a direita
enum-animation-type-bounce = Saltar
enum-animation-type-genie = Génio
enum-animation-type-zoom = Ampliar
enum-animation-type-rotate = Rodar
enum-animation-type-flip = Virar
