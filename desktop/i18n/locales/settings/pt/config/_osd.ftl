settings-osd-enabled = Ativado
    .description = Mostrar sobreposições no ecrã para volume, brilho, etc.

settings-osd-presets = Predefinições de avisos
    .description = Avisos reutilizáveis que podem ser acionados com `lys-shell toast --preset <id>`

settings-osd-position = Posição
    .description = Onde o OSD aparece no ecrã (ex.: top-center, bottom-right)

settings-osd-duration = Duração
    .description = Quanto tempo o OSD fica visível antes de se dispensar automaticamente (ms)

settings-osd-monitor = Monitor
    .description = Que monitor mostra o OSD: "primary" ou um conector como "DP-1"

settings-osd-margin = Margem
    .description = Distância da margem do ecrã ao OSD

settings-osd-border = Contorno
    .description = Desenhar um contorno à volta da sobreposição do OSD

settings-osd-layer = Camada
    .description = Camada layer-shell em que o OSD é colocado. O modo de tearing despromove overlay para top.

settings-osd-text-align = Alinhamento do texto
    .description = Alinhamento horizontal do conteúdo dos avisos/alternâncias do OSD

settings-osd-media = A reproduzir
    .description = Mudanças de faixa que mostram o OSD de reprodução: pedidas (teclas multimédia e `lys-shell media next`), sempre ou nunca


