enum-bar-auto-hide-fullscreen = Em ecrã inteiro

enum-shadow-preset-none = Nenhuma
enum-shadow-preset-drop = Projetada
enum-shadow-preset-floating = Flutuante

enum-border-location-none = Nenhuma
enum-border-location-top = Topo
enum-border-location-bottom = Fundo
enum-border-location-left = Esquerda
enum-border-location-right = Direita
enum-border-location-all = Todas

enum-bar-button-variant-basic = Básico
enum-bar-button-variant-block-prefix = Prefixo em bloco
enum-bar-button-variant-icon-square = Ícone quadrado

enum-icon-position-start = Início
enum-icon-position-end = Fim
