settings-bar-layout = Disposição
    .description = Disposições da barra por monitor que definem a organização dos módulos

settings-bar-scale = Escala
    .description = Multiplicador de escala da barra para espaçamento, arredondamento e outros elementos

settings-bar-inset-edge = Recuo da margem
    .description = Espaço entre a barra e a margem do ecrã a que está presa

settings-bar-inset-ends = Recuo das extremidades
    .description = Espaço nas extremidades da barra (esquerda/direita na horizontal, topo/fundo na vertical)

settings-bar-padding = Preenchimento
    .description = Espaçamento interno ao longo da espessura da barra

settings-bar-padding-ends = Preenchimento das extremidades
    .description = Espaçamento interno nas extremidades da barra

settings-bar-module-gap = Espaço entre módulos
    .description = Espaço entre módulos e grupos na barra

settings-bar-location = Localização
    .description = Posição da barra na margem do ecrã (topo, fundo, esquerda, direita)

settings-bar-exclusive = Exclusiva
    .description = Reservar espaço no ecrã para a barra em vez de a desenhar por cima das janelas

settings-bar-auto-hide = Ocultar automaticamente
    .description = Quando a barra se oculta, mantendo uma faixa fina na sua margem que a revela sob o ponteiro

settings-bar-auto-hide-delay-ms = Atraso de ocultação
    .description = Quanto tempo a barra permanece depois de o ponteiro sair, antes de se ocultar (milissegundos)

settings-bar-layer = Camada
    .description = Camada layer-shell em que a barra é colocada

settings-bar-bg = Fundo
    .description = Cor de fundo da barra

settings-bar-background-opacity = Opacidade do fundo
    .description = Transparência do fundo da barra (0-100%)

settings-bar-border-location = Localização da margem
    .description = Posição da margem da barra

settings-bar-border-width = Largura da margem
    .description = Espessura da margem em píxeis

settings-bar-border-color = Cor da margem
    .description = Cor da margem da barra

settings-bar-rounding = Arredondamento
    .description = Nível de arredondamento dos cantos da barra

settings-bar-shadow-enabled = Sombra
    .description = Ativar sombra projetada na barra

settings-bar-button-opacity = Opacidade geral
    .description = Quão transparente é o botão inteiro, incluindo o ícone e o texto (0-100%)

settings-bar-button-bg-opacity = Preenchimento dos botões
    .description = Quão opaco é o preenchimento por trás do ícone e do texto do botão (0-100%)

settings-bar-button-icon-size = Tamanho dos ícones dos botões
    .description = Multiplicador de tamanho dos ícones dos botões

settings-bar-button-icon-padding = Preenchimento dos ícones dos botões
    .description = Preenchimento à volta dos ícones dos botões. Só se aplica às variantes prefixo em bloco e ícone quadrado.

settings-bar-button-label-size = Tamanho das etiquetas dos botões
    .description = Multiplicador de tamanho do texto dos botões

settings-bar-button-label-weight = Peso das etiquetas dos botões
    .description = Peso do tipo de letra das etiquetas dos botões

settings-bar-button-label-padding = Preenchimento das etiquetas dos botões
    .description = Preenchimento à volta das etiquetas dos botões

settings-bar-button-gap = Espaço nos botões
    .description = Espaço entre o ícone e a etiqueta nos botões

settings-bar-button-icon-position = Posição do ícone dos botões
    .description = Posição do ícone em relação à etiqueta (início ou fim)

settings-bar-button-border-location = Localização da margem dos botões
    .description = Posição da margem dos botões da barra

settings-bar-button-border-width = Largura da margem dos botões
    .description = Espessura da margem dos botões da barra em píxeis

settings-bar-button-group-border-location = Localização da margem dos grupos
    .description = Posição da margem dos grupos de botões

settings-bar-button-group-border-width = Largura da margem dos grupos
    .description = Espessura da margem dos grupos de botões em píxeis

settings-bar-button-group-padding = Preenchimento dos grupos
    .description = Preenchimento interno dos grupos de botões

settings-bar-group-module-gap = Espaço entre módulos do grupo
    .description = Espaço entre módulos dentro de um grupo

settings-bar-button-group-background = Fundo dos grupos
    .description = Cor de fundo dos grupos de botões

settings-bar-button-group-opacity = Opacidade dos grupos
    .description = Transparência dos grupos de botões (0-100%)

settings-bar-button-group-border-color = Cor da margem dos grupos
    .description = Cor da margem dos grupos de botões

settings-bar-dropdown-size = Tamanho do menu pendente
    .description = Multiplicador de tamanho dos painéis dos menus pendentes

settings-bar-dropdown-shadow = Sombra do menu pendente
    .description = Ativar sombra projetada nos menus pendentes

settings-bar-dropdown-opacity = Opacidade do menu pendente
    .description = Transparência dos painéis dos menus pendentes (0-100%)

settings-bar-dropdown-autohide = Ocultar menu pendente automaticamente
    .description = Fechar o menu pendente ao clicar fora dele

settings-bar-dropdown-freeze-label = Manter o texto do botão fixo enquanto está aberto
    .description = Mantém o texto do botão da barra tal como está enquanto o seu menu pendente está aberto, para que o botão não mude de tamanho e o menu fique no lugar

settings-bar-shadow = Sombra
    .description = Ativar sombra projetada

settings-bar-button-variant = Variante dos botões
    .description = Estilo visual dos botões da barra

settings-bar-button-rounding = Arredondamento dos botões
    .description = Arredondamento dos cantos dos botões da barra

settings-bar-button-group-module-gap = Espaço entre módulos do grupo
    .description = Espaço entre módulos dentro de um grupo

settings-bar-button-group-rounding = Arredondamento dos grupos
    .description = Arredondamento dos cantos dos grupos de botões

enum-location-top = Topo
