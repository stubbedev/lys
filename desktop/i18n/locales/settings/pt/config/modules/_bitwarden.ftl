settings-modules-bitwarden-server = Servidor
    .description = bitwarden.com, bitwarden.eu ou o URL base de um servidor próprio. Uma conta com sessão iniciada mantém o servidor em que iniciou sessão

settings-modules-bitwarden-email = Email
    .description = Email com que o formulário de início de sessão começa

settings-modules-bitwarden-lock-with-session = Bloquear com a sessão
    .description = Bloquear o cofre quando a sessão é bloqueada

settings-modules-bitwarden-unlock-with-session = Desbloquear com a sessão
    .description = Desbloquear um cofre bloqueado com a palavra-passe do ecrã de bloqueio, quando esta for a palavra-passe mestra

settings-modules-bitwarden-clipboard-clear = Limpar a área de transferência após (segundos)
    .description = Limpar um segredo copiado após este número de segundos, a menos que tenha sido copiada outra coisa. 0 mantém-no

settings-modules-bitwarden-network-folder = Pasta de redes
    .description = Pasta do cofre cujas credenciais, com o nome da ligação, respondem aos pedidos de palavra-passe de Wi-Fi e VPN enquanto o cofre está aberto. Vazio não responde a nenhum

settings-modules-bitwarden-portal-folder = Pasta de segredos do portal
    .description = Pasta do cofre onde as chaves do porta-chaves das aplicações isoladas são guardadas, depois de autorizar cada uma. Vazio mantém-nas apenas no porta-chaves

settings-modules-bitwarden-generator-passwords = Predefinições de palavras-passe
    .description = Palavras-passe de caracteres aleatórios que o gerador do menu pendente copia

settings-modules-bitwarden-generator-passphrases = Predefinições de frases-passe
    .description = Frases-passe com palavras da lista grande da EFF que o gerador do menu pendente copia

enum-password-charset-lowercase = Minúsculas (a-z)
enum-password-charset-uppercase = Maiúsculas (A-Z)
enum-password-charset-digits = Algarismos (0-9)
enum-password-charset-symbols = Símbolos (!@#$%^&*)

settings-modules-bitwarden-format = Formato
    .description = Cadeia de formato da etiqueta. Marcadores: {"{{ count }}"} (itens no cofre aberto)

settings-modules-bitwarden-icon-locked = Ícone bloqueado
    .description = Ícone enquanto o cofre está bloqueado ou sem sessão iniciada

settings-modules-bitwarden-icon-unlocked = Ícone desbloqueado
    .description = Ícone enquanto o cofre está aberto

settings-modules-bitwarden-border-show = Mostrar contorno
    .description = Mostrar contorno à volta do botão

settings-modules-bitwarden-border-color = Cor do contorno
    .description = Token da cor do contorno

settings-modules-bitwarden-icon-show = Mostrar ícone
    .description = Mostrar o ícone do módulo

settings-modules-bitwarden-tooltip = Mostrar dica
    .description = Mostrar o estado do módulo numa dica ao passar o rato

settings-modules-bitwarden-icon-color = Cor do ícone
    .description = Cor de primeiro plano do ícone

settings-modules-bitwarden-icon-bg-color = Fundo do ícone
    .description = Cor de fundo do contentor do ícone

settings-modules-bitwarden-label-show = Mostrar etiqueta
    .description = Mostrar etiqueta

settings-modules-bitwarden-label-color = Cor da etiqueta
    .description = Cor do texto da etiqueta

settings-modules-bitwarden-label-max-length = Comprimento máximo da etiqueta
    .description = Máximo de caracteres antes de truncar

settings-modules-bitwarden-button-bg-color = Fundo do botão
    .description = Cor de fundo do botão

settings-modules-bitwarden-left-click = Clique esquerdo
    .description = Ação ao clicar com o botão esquerdo. Por predefinição abre o menu pendente do cofre

settings-modules-bitwarden-right-click = Clique direito
    .description = Comando da shell ao clicar com o botão direito

settings-modules-bitwarden-middle-click = Clique do meio
    .description = Comando da shell ao clicar com o botão do meio

settings-modules-bitwarden-scroll-up = Deslocar para cima
    .description = Comando da shell ao deslocar para cima

settings-modules-bitwarden-scroll-down = Deslocar para baixo
    .description = Comando da shell ao deslocar para baixo

settings-modules-bitwarden-format-placeholder-count = Número de itens no cofre aberto (vazio enquanto bloqueado)
