### lys-shell Configuration - Screenshot Module

## Screenshot Module Configuration

settings-modules-screenshot-icon = Symbol
    .description = Symbol der Leistenschaltfläche

settings-modules-screenshot-output-directory = Ausgabeordner
    .description = Wo Bildschirmfotos gespeichert werden (leer verwendet den XDG-Bilderordner)

settings-modules-screenshot-filename-format = Dateinamenformat
    .description = Name der gespeicherten Datei mit strftime-Platzhaltern

settings-modules-screenshot-copy-to-clipboard = In die Zwischenablage kopieren
    .description = Das aufgenommene Bild in die Zwischenablage kopieren

settings-modules-screenshot-notify = Benachrichtigen
    .description = Nach der Aufnahme eine Desktop-Benachrichtigung anzeigen

settings-modules-screenshot-border-show = Rahmen anzeigen
    .description = Rahmen um die Schaltfläche anzeigen

settings-modules-screenshot-border-color = Rahmenfarbe
    .description = Farbtoken des Rahmens

settings-modules-screenshot-icon-show = Symbol anzeigen
    .description = Modulsymbol anzeigen

settings-modules-screenshot-tooltip = Kurzinfo anzeigen
    .description = Den Zustand des Moduls beim Überfahren in einer Kurzinfo anzeigen

settings-modules-screenshot-icon-color = Symbolfarbe
    .description = Vordergrundfarbe des Symbols

settings-modules-screenshot-icon-bg-color = Symbolhintergrund
    .description = Hintergrundfarbe des Symbolcontainers

settings-modules-screenshot-label = Beschriftung
    .description = Fester Beschriftungstext neben dem Symbol

settings-modules-screenshot-label-show = Beschriftung anzeigen
    .description = Beschriftung anzeigen

settings-modules-screenshot-label-color = Beschriftungsfarbe
    .description = Textfarbe der Beschriftung

settings-modules-screenshot-label-max-length = Maximale Beschriftungslänge
    .description = Maximale Zeichenanzahl vor dem Kürzen

settings-modules-screenshot-button-bg-color = Schaltflächenhintergrund
    .description = Hintergrundfarbe der Schaltfläche

settings-modules-screenshot-left-click = Linksklick
    .description = Shell-Befehl bei Linksklick

settings-modules-screenshot-right-click = Rechtsklick
    .description = Shell-Befehl bei Rechtsklick

settings-modules-screenshot-middle-click = Mittelklick
    .description = Shell-Befehl bei Mittelklick

settings-modules-screenshot-scroll-up = Nach oben scrollen
    .description = Shell-Befehl beim Scrollen nach oben

settings-modules-screenshot-scroll-down = Nach unten scrollen
    .description = Shell-Befehl beim Scrollen nach unten

settings-modules-screenshot-thumbnail-ms = Anzeigedauer des Vorschaubilds
    .description = Wie lange das schwebende Vorschaubild nach einer Aufnahme bleibt, in Millisekunden (0 deaktiviert es)

settings-modules-screenshot-thumbnail-position = Position des Vorschaubilds
    .description = Bildschirmecke, in der das schwebende Vorschaubild sitzt

enum-screenshot-corner-top-left = Oben links
enum-screenshot-corner-top-right = Oben rechts
enum-screenshot-corner-bottom-right = Unten rechts
enum-screenshot-corner-bottom-left = Unten links

settings-modules-screenshot-ocr-languages = Sprachen der Texterkennung
    .description = Die installierten Sprachen, in denen Text vom Bildschirm gelesen wird; ohne Auswahl folgt sie der Sitzungssprache
