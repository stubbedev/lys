### lys-shell Configuration - Microphone Module

## Microphone Module Configuration

settings-modules-microphone-icon-active = Symbol für aktiv
    .description = Symbol, wenn das Mikrofon aktiv ist (nicht stumm)

settings-modules-microphone-icon-muted = Symbol für stumm
    .description = Symbol, wenn das Mikrofon stummgeschaltet ist

settings-modules-microphone-border-show = Rahmen anzeigen
    .description = Rahmen um die Schaltfläche anzeigen

settings-modules-microphone-border-color = Rahmenfarbe
    .description = Farbtoken des Rahmens

settings-modules-microphone-icon-show = Symbol anzeigen
    .description = Modulsymbol anzeigen

settings-modules-microphone-tooltip = Kurzinfo anzeigen
    .description = Den Zustand des Moduls beim Überfahren in einer Kurzinfo anzeigen

settings-modules-microphone-icon-color = Symbolfarbe
    .description = Vordergrundfarbe des Symbols

settings-modules-microphone-icon-bg-color = Symbolhintergrund
    .description = Hintergrundfarbe des Symbolcontainers

settings-modules-microphone-label-show = Beschriftung anzeigen
    .description = Prozentbeschriftung anzeigen

settings-modules-microphone-label-color = Beschriftungsfarbe
    .description = Textfarbe der Beschriftung

settings-modules-microphone-label-max-length = Maximale Beschriftungslänge
    .description = Maximale Zeichenanzahl vor dem Kürzen

settings-modules-microphone-button-bg-color = Schaltflächenhintergrund
    .description = Hintergrundfarbe der Schaltfläche

settings-modules-microphone-left-click = Linksklick
    .description = Shell-Befehl bei Linksklick

settings-modules-microphone-right-click = Rechtsklick
    .description = Shell-Befehl bei Rechtsklick

settings-modules-microphone-middle-click = Mittelklick
    .description = Shell-Befehl bei Mittelklick

settings-modules-microphone-scroll-up = Nach oben scrollen
    .description = Aktion beim Scrollen nach oben

settings-modules-microphone-scroll-down = Nach unten scrollen
    .description = Aktion beim Scrollen nach unten

settings-modules-microphone-thresholds = Schwellenwerte
    .description = Farbschwellen, die sich nach dem Wert ändern
