### lys-shell Configuration - Dashboard Module

## Dashboard Module Configuration

settings-modules-dashboard-icon-override = Symbol überschreiben
    .description = Das automatisch erkannte Distributionssymbol überschreiben

settings-modules-dashboard-border-show = Rahmen anzeigen
    .description = Rahmen um die Schaltfläche anzeigen

settings-modules-dashboard-border-color = Rahmenfarbe
    .description = Farbtoken des Rahmens

settings-modules-dashboard-icon-color = Symbolfarbe
    .description = Vordergrundfarbe des Symbols

settings-modules-dashboard-icon-bg-color = Symbolhintergrund
    .description = Hintergrundfarbe des Symbolcontainers

settings-modules-dashboard-right-click = Rechtsklick
    .description = Shell-Befehl bei Rechtsklick

settings-modules-dashboard-middle-click = Mittelklick
    .description = Shell-Befehl bei Mittelklick

settings-modules-dashboard-scroll-up = Nach oben scrollen
    .description = Shell-Befehl beim Scrollen nach oben

settings-modules-dashboard-scroll-down = Nach unten scrollen
    .description = Shell-Befehl beim Scrollen nach unten

settings-modules-dashboard-left-click = Linksklick
    .description = Shell-Befehl bei Linksklick

settings-modules-dashboard-dropdown-lock-command = Sperrbefehl
    .description = Shell-Befehl für die Sperrtaste

settings-modules-dashboard-dropdown-logout-command = Abmeldebefehl
    .description = Shell-Befehl für die Abmeldetaste

settings-modules-dashboard-dropdown-reboot-command = Neustartbefehl
    .description = Shell-Befehl für die Neustarttaste

settings-modules-dashboard-dropdown-poweroff-command = Ausschaltbefehl
    .description = Shell-Befehl für die Ausschalttaste

settings-modules-dashboard-usage-warning = Auslastungswarnung
    .description = CPU-/RAM-/Datenträgerauslastung in Prozent, ab der die Ringe Warnung anzeigen

settings-modules-dashboard-usage-error = Auslastungsfehler
    .description = CPU-/RAM-/Datenträgerauslastung in Prozent, ab der die Ringe Fehler anzeigen

settings-modules-dashboard-temp-warning = Temperaturwarnung
    .description = CPU-Temperatur (°C), ab der der Temperaturring Warnung anzeigt

settings-modules-dashboard-temp-error = Temperaturfehler
    .description = CPU-Temperatur (°C), ab der der Temperaturring Fehler anzeigt

settings-modules-dashboard-battery-warning = Akkuwarnung
    .description = Akkustand in Prozent, bei oder unter dem der Dashboard-Akku Warnung anzeigt

settings-modules-dashboard-battery-critical = Akku kritisch
    .description = Akkustand in Prozent, bei oder unter dem der Dashboard-Akku kritisch anzeigt

settings-modules-dashboard-user-session-actions = Sitzungsaktionen
    .description = Im Dashboard angezeigte Sitzungsaktionen (Sperren, Abmelden, Neu starten, Ausschalten)

