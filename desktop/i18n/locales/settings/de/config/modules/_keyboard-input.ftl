### lys-shell Configuration - Keyboard Input Module

## Keyboard Input Module Configuration

settings-modules-keyboard-input-format = Beschriftungsformat
    .description = Was die Beschriftung zeigt, zusammengesetzt aus den Werten des Elements und eigenem Text

settings-modules-keyboard-input-icon-name = Symbolname
    .description = Symbolischer Symbolname

settings-modules-keyboard-input-border-show = Rahmen anzeigen
    .description = Rahmen um die Schaltfläche anzeigen

settings-modules-keyboard-input-border-color = Rahmenfarbe
    .description = Farbtoken des Rahmens

settings-modules-keyboard-input-icon-show = Symbol anzeigen
    .description = Modulsymbol anzeigen

settings-modules-keyboard-input-tooltip = Kurzinfo anzeigen
    .description = Den Zustand des Moduls beim Überfahren in einer Kurzinfo anzeigen

settings-modules-keyboard-input-icon-color = Symbolfarbe
    .description = Vordergrundfarbe des Symbols

settings-modules-keyboard-input-icon-bg-color = Symbolhintergrund
    .description = Hintergrundfarbe des Symbolcontainers

settings-modules-keyboard-input-label-show = Beschriftung anzeigen
    .description = Beschriftung der Belegung anzeigen

settings-modules-keyboard-input-label-color = Beschriftungsfarbe
    .description = Textfarbe der Beschriftung

settings-modules-keyboard-input-label-max-length = Maximale Beschriftungslänge
    .description = Zeichen, die die Beschriftung zeigt, bevor sie gekürzt wird; 0 kürzt nie

settings-modules-keyboard-input-button-bg-color = Schaltflächenhintergrund
    .description = Hintergrundfarbe der Schaltfläche

settings-modules-keyboard-input-left-click = Linksklick
    .description = Shell-Befehl bei Linksklick

settings-modules-keyboard-input-right-click = Rechtsklick
    .description = Shell-Befehl bei Rechtsklick

settings-modules-keyboard-input-middle-click = Mittelklick
    .description = Shell-Befehl bei Mittelklick

settings-modules-keyboard-input-scroll-up = Nach oben scrollen
    .description = Shell-Befehl beim Scrollen nach oben

settings-modules-keyboard-input-scroll-down = Nach unten scrollen
    .description = Shell-Befehl beim Scrollen nach unten

settings-modules-keyboard-input-layout-alias-map = Kurznamen
    .description = Der Name, den die Leiste für jede Tastaturbelegung zeigt; die in lys-wm eingerichteten Belegungen sind aufgeführt, weitere lassen sich hinzufügen

## Format placeholders

settings-modules-keyboard-input-format-placeholder-layout = Name der Belegung vom Compositor (z. B. English (US))

settings-modules-keyboard-input-format-placeholder-alias = Alias aus der Aliaszuordnung, sonst der Name der Belegung
