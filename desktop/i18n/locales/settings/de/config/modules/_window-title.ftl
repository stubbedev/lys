### lys-shell Configuration - Window Title Module

## Window Title Module Configuration

settings-modules-window-title-format = Beschriftungsformat
    .description = Formatzeichenkette mit Platzhaltern: {"{{ title }}"}, {"{{ app }}"}

settings-modules-window-title-icon-name = Ersatzsymbol
    .description = Symbol, wenn keine Zuordnung passt

settings-modules-window-title-icon-mappings = Symbolzuordnungen
    .description = Glob-Muster zu Symbolnamen (mit Präfix title: für Abgleich am Titel)

settings-modules-window-title-border-show = Rahmen anzeigen
    .description = Rahmen um die Schaltfläche anzeigen

settings-modules-window-title-border-color = Rahmenfarbe
    .description = Farbtoken des Rahmens

settings-modules-window-title-icon-show = Symbol anzeigen
    .description = Modulsymbol anzeigen

settings-modules-window-title-tooltip = Kurzinfo anzeigen
    .description = Den Zustand des Moduls beim Überfahren in einer Kurzinfo anzeigen

settings-modules-window-title-icon-color = Symbolfarbe
    .description = Vordergrundfarbe des Symbols

settings-modules-window-title-icon-bg-color = Symbolhintergrund
    .description = Hintergrundfarbe des Symbolcontainers

settings-modules-window-title-label-show = Beschriftung anzeigen
    .description = Fenstertitel als Beschriftung anzeigen

settings-modules-window-title-label-color = Beschriftungsfarbe
    .description = Textfarbe der Beschriftung

settings-modules-window-title-label-max-length = Maximale Beschriftungslänge
    .description = Maximale Zeichenanzahl vor dem Kürzen (0 zum Deaktivieren)

settings-modules-window-title-button-bg-color = Schaltflächenhintergrund
    .description = Hintergrundfarbe der Schaltfläche

settings-modules-window-title-left-click = Linksklick
    .description = Shell-Befehl bei Linksklick

settings-modules-window-title-right-click = Rechtsklick
    .description = Shell-Befehl bei Rechtsklick

settings-modules-window-title-middle-click = Mittelklick
    .description = Shell-Befehl bei Mittelklick

settings-modules-window-title-scroll-up = Nach oben scrollen
    .description = Shell-Befehl beim Scrollen nach oben

settings-modules-window-title-scroll-down = Nach unten scrollen
    .description = Shell-Befehl beim Scrollen nach unten

## Format placeholders

settings-modules-window-title-format-placeholder-title = Fenstertitel

settings-modules-window-title-format-placeholder-app = Anwendungs-ID (WM_CLASS unter Hyprland)
