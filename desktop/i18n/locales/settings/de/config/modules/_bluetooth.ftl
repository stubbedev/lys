settings-modules-bluetooth-middle-click = Mittelklick
    .description = Shell-Befehl bei Mittelklick

settings-modules-bluetooth-scroll-up = Nach oben scrollen
    .description = Shell-Befehl beim Scrollen nach oben

settings-modules-bluetooth-scroll-down = Nach unten scrollen
    .description = Shell-Befehl beim Scrollen nach unten

settings-modules-bluetooth-left-click = Linksklick
    .description = Aktion bei Linksklick
