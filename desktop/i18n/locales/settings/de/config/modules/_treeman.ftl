### lys-shell Configuration - Treeman Module

## Treeman Module Configuration

settings-modules-treeman-format = Beschriftungsformat
    .description = Formatzeichenkette mit Platzhaltern: {"{{ total }}"}, {"{{ stable }}"}, {"{{ up }}"}, {"{{ down }}"}, {"{{ failed }}"}

settings-modules-treeman-icon-name = Symbol
    .description = Modulsymbol (angezeigt, wenn alle Worktrees ruhend bereit sind)

settings-modules-treeman-icon-preparing = Symbol für Vorbereitung
    .description = Symbol, solange ein Worktree vorbereitet wird

settings-modules-treeman-icon-tearing-down = Symbol für Abbau
    .description = Symbol, solange ein Worktree abgebaut wird

settings-modules-treeman-icon-failed = Symbol für fehlgeschlagen
    .description = Symbol, wenn der letzte Abschluss eines Worktrees fehlgeschlagen ist

settings-modules-treeman-hide-if-empty = Ausblenden, wenn leer
    .description = Das Modul einklappen, wenn keine aktiven Worktrees vorhanden sind

settings-modules-treeman-border-show = Rahmen anzeigen
    .description = Rahmen um die Schaltfläche anzeigen

settings-modules-treeman-border-color = Rahmenfarbe
    .description = Farbtoken des Rahmens

settings-modules-treeman-icon-show = Symbol anzeigen
    .description = Modulsymbol anzeigen

settings-modules-treeman-tooltip = Kurzinfo anzeigen
    .description = Den Zustand des Moduls beim Überfahren in einer Kurzinfo anzeigen

settings-modules-treeman-icon-color = Symbolfarbe
    .description = Vordergrundfarbe des Symbols

settings-modules-treeman-icon-bg-color = Symbolhintergrund
    .description = Hintergrundfarbe des Symbolcontainers

settings-modules-treeman-label-show = Beschriftung anzeigen
    .description = Beschriftung mit der Anzahl anzeigen

settings-modules-treeman-label-color = Beschriftungsfarbe
    .description = Textfarbe der Beschriftung

settings-modules-treeman-label-max-length = Maximale Beschriftungslänge
    .description = Maximale Zeichenanzahl vor dem Kürzen

settings-modules-treeman-button-bg-color = Schaltflächenhintergrund
    .description = Hintergrundfarbe der Schaltfläche

settings-modules-treeman-left-click = Linksklick
    .description = Aktion bei Linksklick

settings-modules-treeman-right-click = Rechtsklick
    .description = Aktion bei Rechtsklick

settings-modules-treeman-middle-click = Mittelklick
    .description = Aktion bei Mittelklick

settings-modules-treeman-scroll-up = Nach oben scrollen
    .description = Aktion beim Scrollen nach oben

settings-modules-treeman-scroll-down = Nach unten scrollen
    .description = Aktion beim Scrollen nach unten

## Format placeholders

settings-modules-treeman-format-placeholder-total = Aktive Worktrees insgesamt

settings-modules-treeman-format-placeholder-stable = Worktrees in der Gruppe „bereit“

settings-modules-treeman-format-placeholder-up = Worktrees in Vorbereitung

settings-modules-treeman-format-placeholder-down = Worktrees im Abbau

settings-modules-treeman-format-placeholder-failed = Worktrees, deren letzter Abschluss fehlgeschlagen ist
