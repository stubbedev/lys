### lys-shell Configuration - RAM Module

## RAM Module Configuration

settings-modules-ram-poll-interval-ms = Abfrageintervall
    .description = Abfrageintervall in Millisekunden

settings-modules-ram-format = Anzeigeformat
    .description = Was die Beschriftung zeigt, zusammengesetzt aus den Werten des Elements und eigenem Text

settings-modules-ram-icon-name = Symbolname
    .description = Symbolischer Symbolname

settings-modules-ram-border-show = Rahmen anzeigen
    .description = Rahmen um die Schaltfläche anzeigen

settings-modules-ram-border-color = Rahmenfarbe
    .description = Farbtoken des Rahmens

settings-modules-ram-icon-show = Symbol anzeigen
    .description = Modulsymbol anzeigen

settings-modules-ram-tooltip = Kurzinfo anzeigen
    .description = Den Zustand des Moduls beim Überfahren in einer Kurzinfo anzeigen

settings-modules-ram-icon-color = Symbolfarbe
    .description = Vordergrundfarbe des Symbols

settings-modules-ram-icon-bg-color = Symbolhintergrund
    .description = Hintergrundfarbe des Symbolcontainers

settings-modules-ram-label-show = Beschriftung anzeigen
    .description = Textbeschriftung anzeigen

settings-modules-ram-label-color = Beschriftungsfarbe
    .description = Textfarbe der Beschriftung

settings-modules-ram-label-max-length = Maximale Beschriftungslänge
    .description = Zeichen, die die Beschriftung zeigt, bevor sie gekürzt wird; 0 kürzt nie

settings-modules-ram-button-bg-color = Schaltflächenhintergrund
    .description = Hintergrundfarbe der Schaltfläche

settings-modules-ram-left-click = Linksklick
    .description = Shell-Befehl bei Linksklick

settings-modules-ram-right-click = Rechtsklick
    .description = Shell-Befehl bei Rechtsklick

settings-modules-ram-middle-click = Mittelklick
    .description = Shell-Befehl bei Mittelklick

settings-modules-ram-scroll-up = Nach oben scrollen
    .description = Shell-Befehl beim Scrollen nach oben

settings-modules-ram-scroll-down = Nach unten scrollen
    .description = Shell-Befehl beim Scrollen nach unten

## Format placeholders

settings-modules-ram-format-placeholder-percent = Speicherauslastung (0–100)

settings-modules-ram-format-placeholder-used-gib = Belegter Speicher in GiB

settings-modules-ram-format-placeholder-total-gib = Gesamtspeicher in GiB

settings-modules-ram-format-placeholder-available-gib = Verfügbarer Speicher in GiB

settings-modules-ram-format-placeholder-swap-percent = Swap-Auslastung (0–100)

settings-modules-ram-format-placeholder-swap-used-gib = Belegter Swap in GiB

settings-modules-ram-format-placeholder-swap-total-gib = Gesamter Swap in GiB
