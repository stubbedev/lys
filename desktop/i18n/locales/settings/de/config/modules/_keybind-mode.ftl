### lys-shell Configuration - Keybind Mode Module

## Keybind Mode Module Configuration

settings-modules-keybind-mode-format = Beschriftungsformat
    .description = Was die Beschriftung zeigt, zusammengesetzt aus den Werten des Elements und eigenem Text

settings-modules-keybind-mode-icon-name = Symbolname
    .description = Symbolischer Symbolname

settings-modules-keybind-mode-auto-hide = Automatisch ausblenden
    .description = Modul ausblenden, wenn kein Modus aktiv ist

settings-modules-keybind-mode-border-show = Rahmen anzeigen
    .description = Rahmen um die Schaltfläche anzeigen

settings-modules-keybind-mode-border-color = Rahmenfarbe
    .description = Farbtoken des Rahmens

settings-modules-keybind-mode-icon-show = Symbol anzeigen
    .description = Modulsymbol anzeigen

settings-modules-keybind-mode-tooltip = Kurzinfo anzeigen
    .description = Den Zustand des Moduls beim Überfahren in einer Kurzinfo anzeigen

settings-modules-keybind-mode-icon-color = Symbolfarbe
    .description = Vordergrundfarbe des Symbols

settings-modules-keybind-mode-icon-bg-color = Symbolhintergrund
    .description = Hintergrundfarbe des Symbolcontainers

settings-modules-keybind-mode-label-show = Beschriftung anzeigen
    .description = Modusbeschriftung anzeigen

settings-modules-keybind-mode-label-color = Beschriftungsfarbe
    .description = Textfarbe der Beschriftung

settings-modules-keybind-mode-label-max-length = Maximale Beschriftungslänge
    .description = Zeichen, die die Beschriftung zeigt, bevor sie gekürzt wird; 0 kürzt nie

settings-modules-keybind-mode-button-bg-color = Schaltflächenhintergrund
    .description = Hintergrundfarbe der Schaltfläche

settings-modules-keybind-mode-left-click = Linksklick
    .description = Shell-Befehl bei Linksklick

settings-modules-keybind-mode-right-click = Rechtsklick
    .description = Shell-Befehl bei Rechtsklick

settings-modules-keybind-mode-middle-click = Mittelklick
    .description = Shell-Befehl bei Mittelklick

settings-modules-keybind-mode-scroll-up = Nach oben scrollen
    .description = Shell-Befehl beim Scrollen nach oben

settings-modules-keybind-mode-scroll-down = Nach unten scrollen
    .description = Shell-Befehl beim Scrollen nach unten

## Format placeholders

settings-modules-keybind-mode-format-placeholder-mode = Name des aktuellen Tastenbelegungsmodus (default, wenn keiner aktiv ist)
