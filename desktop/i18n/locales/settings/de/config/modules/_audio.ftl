### lys-shell Configuration - Audio Module

## Audio Module Configuration

settings-modules-audio-speaker-icons = Lautsprechersymbole
    .description = Lautsprechersymbole für Lautstärken von niedrig bis maximal

settings-modules-audio-speaker-icon-muted = Symbol für stummen Lautsprecher
    .description = Lautsprechersymbol, solange die Ausgabe stummgeschaltet ist

settings-modules-audio-mic-icon = Mikrofonsymbol
    .description = Mikrofonsymbol, solange die Eingabe aktiv ist

settings-modules-audio-mic-icon-muted = Symbol für stummes Mikrofon
    .description = Mikrofonsymbol, solange die Eingabe stummgeschaltet ist

settings-modules-audio-mic-hide-when-idle = Mikrofon im Leerlauf ausblenden
    .description = Das Mikrofonsymbol nur anzeigen, solange eine App das Mikrofon aufnimmt

settings-modules-audio-capture-camera-icon = Kamerasymbol
    .description = Symbol, solange eine App eine Kamera geöffnet hält

settings-modules-audio-capture-screen-icon = Bildschirmsymbol
    .description = Symbol, solange eine App den Bildschirm freigibt

settings-modules-audio-capture-color = Aufnahmefarbe
    .description = Farbe des Mikrofonsymbols, solange eine App es aufnimmt, sowie der Kamera- und Bildschirmsymbole

settings-modules-audio-border-show = Rahmen anzeigen
    .description = Rahmen um die Schaltfläche anzeigen

settings-modules-audio-border-color = Rahmenfarbe
    .description = Farbtoken des Rahmens

settings-modules-audio-icon-show = Symbol anzeigen
    .description = Das Lautsprechersymbol anzeigen

settings-modules-audio-tooltip = Kurzinfo anzeigen
    .description = Den Zustand des Moduls beim Überfahren in einer Kurzinfo anzeigen

settings-modules-audio-icon-color = Symbolfarbe
    .description = Vordergrundfarbe des Symbols

settings-modules-audio-icon-bg-color = Symbolhintergrund
    .description = Hintergrundfarbe des Symbolcontainers

settings-modules-audio-label-show = Beschriftung anzeigen
    .description = Die Beschriftung anzeigen

settings-modules-audio-label-color = Beschriftungsfarbe
    .description = Textfarbe der Beschriftung

settings-modules-audio-format = Format
    .description = Beschriftungsvorlage (z. B. {"{{"} percent {"}}"} %)

settings-modules-audio-label-max-length = Maximale Beschriftungslänge
    .description = Maximale Zeichenanzahl vor dem Kürzen

settings-modules-audio-button-bg-color = Schaltflächenhintergrund
    .description = Hintergrundfarbe der Schaltfläche

settings-modules-audio-left-click = Linksklick
    .description = Aktion bei Linksklick

settings-modules-audio-right-click = Rechtsklick
    .description = Aktion bei Rechtsklick

settings-modules-audio-middle-click = Mittelklick
    .description = Aktion bei Mittelklick

settings-modules-audio-scroll-up = Nach oben scrollen
    .description = Aktion beim Scrollen nach oben

settings-modules-audio-scroll-down = Nach unten scrollen
    .description = Aktion beim Scrollen nach unten

settings-modules-audio-dropdown-app-icons = App-Symbole im Dropdown
    .description = Anwendungssymbole im Audio-Dropdown anzeigen

settings-modules-audio-thresholds = Schwellenwerte
    .description = Farbschwellen, die sich mit der Lautsprecherlautstärke ändern

## AppIconSource variants
enum-app-icon-source-mapped = Zugeordnet
enum-app-icon-source-native = Nativ


## Format placeholders

settings-modules-audio-format-placeholder-percent = Lautsprecherlautstärke (0–100)
settings-modules-audio-format-placeholder-mic-percent = Mikrofonlautstärke (0–100), leer ohne Mikrofon
