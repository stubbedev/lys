### lys-shell Configuration - Brightness Module

## Brightness Module Configuration

settings-modules-brightness-level-icons = Stufensymbole
    .description = Symbole für verschiedene Helligkeitsstufen, von dunkel bis voll

settings-modules-brightness-border-show = Rahmen anzeigen
    .description = Rahmen um die Schaltfläche anzeigen

settings-modules-brightness-border-color = Rahmenfarbe
    .description = Farbtoken des Rahmens

settings-modules-brightness-icon-show = Symbol anzeigen
    .description = Modulsymbol anzeigen

settings-modules-brightness-tooltip = Kurzinfo anzeigen
    .description = Den Zustand des Moduls beim Überfahren in einer Kurzinfo anzeigen

settings-modules-brightness-icon-color = Symbolfarbe
    .description = Vordergrundfarbe des Symbols

settings-modules-brightness-icon-bg-color = Symbolhintergrund
    .description = Hintergrundfarbe des Symbolcontainers

settings-modules-brightness-label-show = Beschriftung anzeigen
    .description = Prozentbeschriftung anzeigen

settings-modules-brightness-label-color = Beschriftungsfarbe
    .description = Textfarbe der Beschriftung

settings-modules-brightness-label-max-length = Maximale Beschriftungslänge
    .description = Zeichen, die die Beschriftung zeigt, bevor sie gekürzt wird; 0 kürzt nie

settings-modules-brightness-min-brightness = Minimale Helligkeit
    .description = Untergrenze (%) für die Anpassungsaktion und lys-shell brightness, damit ein Dimmer nie ganz dunkel wird; verwenden Sie den Verdunkelungsschalter, um 0 % zu erreichen

settings-modules-brightness-enable-external = Externe Monitore
    .description = Externe Monitore über DDC/CI steuern; benötigt das Modul i2c-dev und Zugriff auf /dev/i2c-*

settings-modules-brightness-button-bg-color = Schaltflächenhintergrund
    .description = Hintergrundfarbe der Schaltfläche

settings-modules-brightness-format = Format
    .description = Was die Beschriftung zeigt, zusammengesetzt aus den Werten des Elements und eigenem Text

settings-modules-brightness-left-click = Linksklick
    .description = Aktion bei Linksklick

settings-modules-brightness-right-click = Rechtsklick
    .description = Aktion bei Rechtsklick

settings-modules-brightness-middle-click = Mittelklick
    .description = Aktion bei Mittelklick

settings-modules-brightness-scroll-up = Nach oben scrollen
    .description = Aktion beim Scrollen nach oben

settings-modules-brightness-scroll-down = Nach unten scrollen
    .description = Aktion beim Scrollen nach unten

settings-modules-brightness-thresholds = Schwellenwerte
    .description = Farbschwellen, die sich nach der Helligkeit ändern

## Format placeholders

settings-modules-brightness-format-placeholder-percent = Helligkeit (0–100)
