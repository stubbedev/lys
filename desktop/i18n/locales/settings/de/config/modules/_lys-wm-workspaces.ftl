### lys-shell Configuration - lys-wm Workspaces Module

## lys-wm Workspaces Module Configuration

settings-modules-lys-wm-workspaces-monitor-specific = Monitorspezifisch
    .description = Nur Arbeitsflächen auf diesem Monitor anzeigen

settings-modules-lys-wm-workspaces-display-mode = Anzeigemodus
    .description = Was jede Arbeitsfläche kennzeichnet (Beschriftung, Symbol oder nichts)

settings-modules-lys-wm-workspaces-divider = Trenner
    .description = Text zwischen Arbeitsflächenkennung und App-Symbolen

settings-modules-lys-wm-workspaces-urgent-show = Dringende anzeigen
    .description = Pulsanimation auf Arbeitsflächen mit dringenden Fenstern

settings-modules-lys-wm-workspaces-urgent-mode = Dringlichkeitsmodus
    .description = Die ganze Arbeitsfläche oder nur das dringende App-Symbol pulsieren lassen

settings-modules-lys-wm-workspaces-app-icons-show = App-Symbole anzeigen
    .description = Fenstersymbole pro Arbeitsfläche anzeigen

settings-modules-lys-wm-workspaces-app-icons-dedupe = Doppelte Symbole zusammenfassen
    .description = Ein Symbol pro app_id statt eines pro Fenster anzeigen

settings-modules-lys-wm-workspaces-app-icons-fallback = Ersatzsymbol
    .description = Symbol für Fenster, die nicht in app-icon-map erfasst sind

settings-modules-lys-wm-workspaces-app-icons-empty = Symbol für leere
    .description = Symbol, wenn eine Arbeitsfläche keine Anwendungsfenster hat

settings-modules-lys-wm-workspaces-icon-gap = Symbolabstand
    .description = Abstand zwischen App-Symbolen

settings-modules-lys-wm-workspaces-workspace-padding = Innenabstand der Arbeitsfläche
    .description = Innenabstand für Inhalte, die breiter als der Kreis sind: App-Symbole, ein Trenner oder ein langer Name. Eine kurze Beschriftung erhält keinen: Sie bestimmt stattdessen die Kreisgröße

settings-modules-lys-wm-workspaces-icon-size = Symbolgröße
    .description = Skalierungsfaktor für Arbeitsflächensymbole (0.25–3.0)

settings-modules-lys-wm-workspaces-label-size = Beschriftungsgröße
    .description = Skalierungsfaktor für Arbeitsflächenbeschriftungen (0.25–3.0)

settings-modules-lys-wm-workspaces-workspace-ignore = Arbeitsflächen ignorieren
    .description = Glob-Muster, die mit der Arbeitsflächennummer abgeglichen werden

settings-modules-lys-wm-workspaces-active-indicator = Aktivitätsanzeige
    .description = Visueller Stil der aktiven Arbeitsfläche

settings-modules-lys-wm-workspaces-active-color = Aktive Farbe
    .description = Farbe für Symbol und Beschriftung der aktiven Arbeitsfläche

settings-modules-lys-wm-workspaces-occupied-color = Farbe für belegte
    .description = Farbe für Symbole und Beschriftungen belegter Arbeitsflächen

settings-modules-lys-wm-workspaces-empty-color = Farbe für leere
    .description = Farbe für Symbole und Beschriftungen leerer Arbeitsflächen

settings-modules-lys-wm-workspaces-container-bg-color = Containerhintergrund
    .description = Hintergrundfarbe des Arbeitsflächencontainers

settings-modules-lys-wm-workspaces-border-show = Rahmen anzeigen
    .description = Rahmen um den Arbeitsflächencontainer anzeigen

settings-modules-lys-wm-workspaces-border-color = Rahmenfarbe
    .description = Rahmenfarbe des Arbeitsflächencontainers

settings-modules-lys-wm-workspaces-workspace-map = Arbeitsflächenzuordnung
    .description = Symbol- und Farbüberschreibungen pro Arbeitsfläche, nach Arbeitsflächennummer

settings-modules-lys-wm-workspaces-app-icon-map = App-Symbolzuordnung
    .description = Zuordnung von Fenster-app_id oder -Titel zu Symbolen

settings-modules-lys-wm-workspaces-left-click = Linksklick
    .description = Aktion bei Linksklick

settings-modules-lys-wm-workspaces-middle-click = Mittelklick
    .description = Aktion bei Mittelklick

settings-modules-lys-wm-workspaces-right-click = Rechtsklick
    .description = Aktion bei Rechtsklick

settings-modules-lys-wm-workspaces-scroll-up = Nach oben scrollen
    .description = Aktion beim Scrollen nach oben

settings-modules-lys-wm-workspaces-scroll-down = Nach unten scrollen
    .description = Aktion beim Scrollen nach unten
