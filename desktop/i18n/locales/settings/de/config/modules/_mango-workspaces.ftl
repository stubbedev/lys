### lys-shell Configuration - Mango Workspaces Module

## Mango Workspaces Module Configuration

settings-modules-mango-workspaces-hide-empty = Leere ausblenden
    .description = Tags ohne Clients ausblenden, sofern sie nicht aktiv sind

settings-modules-mango-workspaces-min-tag-count = Mindestanzahl Tags
    .description = Tags bis zu diesem Index immer anzeigen, auch wenn sie leer sind

settings-modules-mango-workspaces-display-mode = Anzeigemodus
    .description = Was jeden Tag kennzeichnet (Beschriftung, Symbol oder nichts)

settings-modules-mango-workspaces-divider = Trenner
    .description = Text zwischen der Tag-Beschriftung und seinen Anwendungssymbolen

settings-modules-mango-workspaces-app-icons-show = App-Symbole anzeigen
    .description = Ein Anwendungssymbol pro Client auf jedem Tag anzeigen

settings-modules-mango-workspaces-app-icons-dedupe = Doppelte Symbole zusammenfassen
    .description = Ein Symbol pro Anwendung statt eines pro Client anzeigen

settings-modules-mango-workspaces-app-icons-fallback = Ersatzsymbol
    .description = Symbol für Clients, die nicht in app-icon-map erfasst sind

settings-modules-mango-workspaces-app-icons-empty = Symbol für leere
    .description = Symbol, wenn ein Tag keine Clients hat

settings-modules-mango-workspaces-icon-gap = Symbolabstand
    .description = Abstand zwischen Anwendungssymbolen

settings-modules-mango-workspaces-icon-size = Symbolgröße
    .description = Skalierungsfaktor für Anwendungssymbole (0.25–3.0)

settings-modules-mango-workspaces-app-icon-map = App-Symbolzuordnung
    .description = Zuordnung von Client-App-ID oder -Titel zu Symbolen

settings-modules-mango-workspaces-tag-map = Tag-Zuordnung
    .description = Symbol- und Farbüberschreibungen pro Tag, nach Tag-Index

settings-modules-mango-workspaces-urgent-show = Dringende anzeigen
    .description = Pulsanimation auf Tags mit dringenden Clients

settings-modules-mango-workspaces-urgent-mode = Dringlichkeitsmodus
    .description = Den ganzen Tag oder nur die dringende Anwendung pulsieren lassen

settings-modules-mango-workspaces-active-indicator = Aktivitätsanzeige
    .description = Visueller Stil des aktiven Tags

settings-modules-mango-workspaces-tag-padding = Tag-Innenabstand
    .description = Innenabstand entlang der Leistenrichtung

settings-modules-mango-workspaces-label-size = Beschriftungsgröße
    .description = Skalierungsfaktor für Tag-Beschriftungen (0.25–3.0)

settings-modules-mango-workspaces-active-color = Aktive Farbe
    .description = Farbe für die Beschriftung des aktiven Tags

settings-modules-mango-workspaces-occupied-color = Farbe für belegte
    .description = Farbe für Tags mit Clients

settings-modules-mango-workspaces-empty-color = Farbe für leere
    .description = Farbe für leere Tags

settings-modules-mango-workspaces-container-bg-color = Containerhintergrund
    .description = Hintergrundfarbe des Tag-Containers

settings-modules-mango-workspaces-border-show = Rahmen anzeigen
    .description = Rahmen um den Tag-Container anzeigen

settings-modules-mango-workspaces-border-color = Rahmenfarbe
    .description = Rahmenfarbe des Tag-Containers

settings-modules-mango-workspaces-left-click = Linksklick
    .description = Aktion bei Linksklick

settings-modules-mango-workspaces-middle-click = Mittelklick
    .description = Aktion bei Mittelklick

settings-modules-mango-workspaces-right-click = Rechtsklick
    .description = Aktion bei Rechtsklick

settings-modules-mango-workspaces-scroll-up = Nach oben scrollen
    .description = Aktion beim Scrollen nach oben

settings-modules-mango-workspaces-scroll-down = Nach unten scrollen
    .description = Aktion beim Scrollen nach unten
