settings-modules-battery-icon-bg-color = Symbolhintergrund
    .description = Hintergrundfarbe des Symbolcontainers

settings-modules-battery-label-show = Beschriftung anzeigen
    .description = Prozentbeschriftung anzeigen

settings-modules-battery-label-color = Beschriftungsfarbe
    .description = Textfarbe der Beschriftung

settings-modules-battery-label-max-length = Maximale Beschriftungslänge
    .description = Zeichen, die die Beschriftung zeigt, bevor sie gekürzt wird; 0 kürzt nie

settings-modules-battery-button-bg-color = Schaltflächenhintergrund
    .description = Hintergrundfarbe der Schaltfläche

settings-modules-battery-right-click = Rechtsklick
