settings-modules-battery-scroll-up = Nach oben scrollen
    .description = Shell-Befehl beim Scrollen nach oben

settings-modules-battery-scroll-down = Nach unten scrollen
    .description = Shell-Befehl beim Scrollen nach unten

settings-modules-battery-format = Format
    .description = Was die Beschriftung zeigt, zusammengesetzt aus den Werten des Elements und eigenem Text

settings-modules-battery-left-click = Linksklick
    .description = Aktion bei Linksklick

settings-modules-battery-notify-low = Benachrichtigungen bei schwachem Akku
    .description = Benachrichtigen, wenn der Akku oder ein Peripheriegerät den niedrigen oder kritischen Stand erreicht

settings-modules-battery-notify-charged-at = Benachrichtigung bei Ladeende
    .description = Einmal benachrichtigen, wenn das Laden diesen Prozentwert erreicht (0 deaktiviert)

settings-modules-battery-app-nap = App Nap
    .description = Wie tief jede App ruht, solange du sie nicht siehst

