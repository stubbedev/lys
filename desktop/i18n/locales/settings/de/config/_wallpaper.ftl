### lys-shell Configuration - Wallpaper Settings

## Wallpaper

settings-wallpaper-wallpaper = Hintergrundbild
    .description = Eine einzelne Bilddatei für alle Monitore (leer lassen für Wechsel / pro Monitor)

settings-wallpaper-fit-mode = Skalierung
    .description = Wie das Hintergrundbild an den Bildschirm angepasst wird (fill, fit, center, stretch)

## Cycling

settings-wallpaper-cycling-directory = Wechselordner
    .description = Ordner mit Bildern zum Durchwechseln; setzen, um den Wechsel zu aktivieren, leer lassen zum Deaktivieren

settings-wallpaper-cycling-options = Wechseloptionen
    .description = Reihenfolge, Intervall und Verhalten bei mehreren Monitoren während des Wechsels

settings-wallpaper-cycling-mode = Wechselmodus
    .description = Reihenfolge des Hintergrundbildwechsels (nacheinander oder zufällig)

settings-wallpaper-cycling-interval-mins = Wechselintervall
    .description = Zeit zwischen Hintergrundbildwechseln in Minuten

settings-wallpaper-cycling-same-image = Gleiches Bild auf allen Monitoren
    .description = Dasselbe wechselnde Hintergrundbild auf allen Monitoren zeigen (betrifft nur den Zufallsmodus)

settings-wallpaper-picker-directories = Ordner der Auswahl
    .description = Ordner, aus denen die Hintergrundbildauswahl Bilder auflistet (leer: der Wechselordner und Pictures/Wallpapers)

settings-wallpaper-oled-dim = Auf OLED im Akkubetrieb abdunkeln
    .description = Dunkelt das Hintergrundbild auf OLED-Bildschirmen im Akkubetrieb ab, wo dunkle Pixel weniger Strom brauchen

settings-wallpaper-monitors = Hintergrundbilder pro Monitor
    .description = Zuweisung von Hintergrundbildern pro Monitor


## FitMode variants
enum-fit-mode-fill = Füllen
enum-fit-mode-fit = Einpassen
enum-fit-mode-center = Zentrieren
enum-fit-mode-stretch = Strecken

## CyclingMode variants
enum-cycling-mode-sequential = Nacheinander
enum-cycling-mode-shuffle = Zufällig
