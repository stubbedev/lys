settings-animations-enabled = Aktiviert
    .description = Ein- und Ausblenden von OSD, Toasts und Benachrichtigungen animieren und Symbolwechsel überblenden

settings-animations-duration = Dauer
    .description = Animationsdauer in Millisekunden

settings-animations-transition = Übergang
    .description = Ein-/Ausblendstil für OSD, Toasts und Benachrichtigungskarten

settings-animations-enter = Einblendübergang
    .description = Übergang beim Erscheinen von Oberflächen. Ohne Wert wird Übergang verwendet

settings-animations-exit = Ausblendübergang
    .description = Übergang beim Verschwinden von Oberflächen. Ohne Wert wird Übergang verwendet

settings-animations-enter-duration = Einblenddauer
    .description = Dauer der Einblendanimation in Millisekunden. Ohne Wert wird Dauer verwendet

settings-animations-exit-duration = Ausblenddauer
    .description = Dauer der Ausblendanimation in Millisekunden. Ohne Wert wird Dauer verwendet

settings-animations-interaction-duration = Interaktionsdauer
    .description = Dauer in ms von Hover- und Seitenübergängen in Dropdowns. Deaktivierte Animationen entfernen sie

settings-animations-ui-duration = UI-Dauer
    .description = Basisdauer in ms für allgemeine kleine UI-Übergänge (Hover, Fokus, Farbüberblendungen)

settings-animations-reduced-motion = Reduzierte Bewegung
    .description = Bewegung hier und in Apps durch Überblendungen ersetzen: nichts gleitet, schwingt oder springt, und Endlos-Anzeigen stoppen. Unter lys-wm ohne Wirkung: setzen Sie dort animations.reduced_motion in der Konfiguration

settings-animations-indicators = Anzeigen
    .description = Endlos laufende Statusanzeigen ausführen: Ladekreise, Suchanimationen, das Aufnahme-Pulsieren, das Blinken der Uhr

settings-animations-notifications = Benachrichtigungen
    .description = Animationsüberschreibung für Benachrichtigungs-Popup-Karten
settings-animations-menu = Menüs
    .description = Animation pro Oberfläche für Menüs, Kontextmenüs, Dropdown-Listen und Fenstervorschauen

settings-animations-osd = OSD
    .description = Animationsüberschreibung für das OSD (Lautstärke/Helligkeit/Umschalter)

settings-animations-dropdown = Dropdown
    .description = Animationsüberschreibung für die Dropdowns der Leistenmodule

settings-animations-share-picker = Freigabeauswahl
    .description = Animationsüberschreibung für die Auswahl der Bildschirmfreigabe

settings-animations-wallpaper = Hintergrundbild
    .description = Animationsüberschreibung für die Überblendung des Hintergrundbilds

settings-animations-power = Energiemenü
    .description = Animationsüberschreibung für das Energiemenü

settings-animations-dialog = Portal-Dialog
    .description = Animationsüberschreibung für Portal-Dialoge (Zugriffs-, Konto-, App-Auswahl- und Installationsabfragen)

settings-animations-file-chooser = Portal-Dateiauswahl
    .description = Animationsüberschreibung für die Portal-Dateiauswahl

settings-animations-print = Portal-Drucken
    .description = Animationsüberschreibung für den Portal-Druckdialog

settings-animations-lock = Sperrbildschirm
    .description = Animationsüberschreibung für das Erscheinen des Sperrbildschirms


