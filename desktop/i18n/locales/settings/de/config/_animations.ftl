enum-animation-type-none = Keine
enum-animation-type-fade = Überblenden
enum-animation-type-slide-up = Nach oben gleiten
enum-animation-type-slide-down = Nach unten gleiten
enum-animation-type-slide-left = Nach links gleiten
enum-animation-type-slide-right = Nach rechts gleiten
enum-animation-type-swing-up = Nach oben schwingen
enum-animation-type-swing-down = Nach unten schwingen
enum-animation-type-swing-left = Nach links schwingen
enum-animation-type-swing-right = Nach rechts schwingen
enum-animation-type-bounce = Springen
enum-animation-type-genie = Flaschengeist
enum-animation-type-zoom = Zoomen
enum-animation-type-rotate = Drehen
enum-animation-type-flip = Kippen
