settings-clipboard-history-mib = Verlaufsgröße
    .description = Höchster Speicher für den Zwischenablageverlauf in MiB; die ältesten Einträge werden zuerst vergessen

settings-clipboard-pinned-mib = Größe der Angehefteten
    .description = Höchstgröße der angehefteten Einträge in MiB; darüber hinaus wird Anheften abgelehnt

settings-clipboard-persist = Verlauf behalten
    .description = Zwischenablageverlauf über Neustarts hinweg behalten; als geheim markierte Auswahlen werden nie behalten
