### Configuration lys-shell - Module Audio

## Configuration du module Audio

settings-modules-audio-speaker-icons = Icônes du haut-parleur
    .description = Icônes du haut-parleur pour les niveaux de volume, du plus bas au maximum

settings-modules-audio-speaker-icon-muted = Icône du haut-parleur coupé
    .description = Icône du haut-parleur affichée lorsque la sortie est coupée

settings-modules-audio-mic-icon = Icône du micro
    .description = Icône du micro affichée lorsque l'entrée est active

settings-modules-audio-mic-icon-muted = Icône du micro coupé
    .description = Icône du micro affichée lorsque l'entrée est coupée

settings-modules-audio-mic-hide-when-idle = Masquer le micro au repos
    .description = Afficher l'icône du micro uniquement quand une application enregistre le micro

settings-modules-audio-capture-camera-icon = Icône de la caméra
    .description = Icône affichée quand une application tient une caméra ouverte

settings-modules-audio-capture-screen-icon = Icône de l'écran
    .description = Icône affichée quand une application partage l'écran

settings-modules-audio-capture-color = Couleur de capture
    .description = Couleur de l'icône du micro quand une application l'enregistre, et des icônes de la caméra et de l'écran

settings-modules-audio-border-show = Afficher la bordure
    .description = Afficher une bordure autour du bouton

settings-modules-audio-border-color = Couleur de la bordure
    .description = Jeton de couleur de la bordure

settings-modules-audio-icon-show = Afficher l'icône
    .description = Afficher l'icône du haut-parleur

settings-modules-audio-tooltip = Afficher l'infobulle
    .description = Afficher l'état du module dans une infobulle au survol

settings-modules-audio-icon-color = Couleur de l'icône
    .description = Couleur de premier plan de l'icône

settings-modules-audio-icon-bg-color = Arrière-plan de l'icône
    .description = Couleur d'arrière-plan du conteneur d'icône

settings-modules-audio-label-show = Afficher le libellé
    .description = Afficher le libellé

settings-modules-audio-label-color = Couleur du libellé
    .description = Couleur du texte du libellé

settings-modules-audio-format = Format
    .description = Modèle du libellé (ex. : {"{{"} percent {"}}"} %)

settings-modules-audio-label-max-length = Longueur max. du libellé
    .description = Nombre maximal de caractères avant troncature

settings-modules-audio-button-bg-color = Arrière-plan du bouton
    .description = Couleur d'arrière-plan du bouton

settings-modules-audio-left-click = Clic gauche
    .description = Action au clic gauche

settings-modules-audio-right-click = Clic droit
    .description = Action au clic droit

settings-modules-audio-middle-click = Clic central
    .description = Action au clic central

settings-modules-audio-scroll-up = Défilement vers le haut
    .description = Action au défilement vers le haut

settings-modules-audio-scroll-down = Défilement vers le bas
    .description = Action au défilement vers le bas

settings-modules-audio-dropdown-app-icons = Icônes d'applications dans le menu déroulant
    .description = Afficher les icônes d'applications dans le menu déroulant audio

settings-modules-audio-thresholds = Seuils
    .description = Seuils de couleur qui changent selon le volume du haut-parleur

## Variantes de AppIconSource
enum-app-icon-source-mapped = Associé
enum-app-icon-source-native = Natif

## Format placeholders

settings-modules-audio-format-placeholder-percent = Volume du haut-parleur (0-100)
settings-modules-audio-format-placeholder-mic-percent = Volume du micro (0-100), vide sans micro
