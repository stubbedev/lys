## Quick Look: the preview of a file
preview-kind-folder = Folder
preview-kind-file = File
preview-kind-typed = { $type } file
preview-folder-items = { $count ->
    [one] { $shown } item
   *[other] { $shown } items
}
preview-folder-items-capped = { $shown }+ items
preview-size-at-least = at least { $size }
preview-open = Open
preview-failed-unreadable = This file cannot be read.
preview-failed-undecodable = This file cannot be shown: it is damaged or in a format that cannot be read.
preview-failed-too-large = This picture is too large to preview.
preview-failed-unsupported = This video cannot be played: its format or codec is not supported.
