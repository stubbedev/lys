## Snelle weergave: het voorbeeld van een bestand
preview-kind-folder = Map
preview-kind-file = Bestand
preview-kind-typed = { $type }-bestand
preview-folder-items = { $count ->
    [one] { $shown } item
   *[other] { $shown } items
}
preview-folder-items-capped = { $shown }+ items
preview-size-at-least = minstens { $size }
preview-open = Openen
preview-failed-unreadable = Dit bestand kan niet worden gelezen.
preview-failed-undecodable = Dit bestand kan niet worden weergegeven: het is beschadigd of in een onleesbaar formaat.
preview-failed-too-large = Deze afbeelding is te groot voor een voorbeeld.
preview-failed-unsupported = Deze video kan niet worden afgespeeld: het formaat of de codec wordt niet ondersteund.
preview-document-damaged = Het document is beschadigd en kan niet worden getoond.
preview-document-encrypted = Het document is beveiligd met een wachtwoord.
preview-document-too-large = De pagina is te groot om te tonen.
preview-document-timeout = Het tonen van de pagina duurde te lang.
preview-document-unsupported = Dit soort document kan niet worden getoond.
preview-document-failed = Het document kon niet worden getoond.
preview-archive-name = Naam
preview-archive-size = Grootte
preview-archive-modified = Gewijzigd
preview-font-sample = Pa’s wijze lynx bezag vroom het fikse aquaduct
preview-table-rows = { $count ->
    [one] { $shown } rij
   *[other] { $shown } rijen
}
preview-table-rows-capped = { $shown }+ rijen
