## Coup d’œil : l’aperçu d’un fichier
preview-kind-folder = Dossier
preview-kind-file = Fichier
preview-kind-typed = Fichier { $type }
preview-folder-items = { $count ->
    [one] { $shown } élément
   *[other] { $shown } éléments
}
preview-folder-items-capped = Plus de { $shown } éléments
preview-size-at-least = au moins { $size }
preview-open = Ouvrir
preview-failed-unreadable = Impossible de lire ce fichier.
preview-failed-undecodable = Impossible d’afficher ce fichier : il est endommagé ou dans un format illisible.
preview-failed-too-large = Cette image est trop grande pour l’aperçu.
preview-failed-unsupported = Impossible de lire cette vidéo : son format ou son codec n’est pas pris en charge.
preview-document-damaged = Le document est endommagé et ne peut pas être affiché.
preview-document-encrypted = Le document est protégé par un mot de passe.
preview-document-too-large = La page est trop grande pour être affichée.
preview-document-timeout = L’affichage de la page a pris trop de temps.
preview-document-unsupported = Ce type de document ne peut pas être affiché.
preview-document-failed = Le document n’a pas pu être affiché.
preview-archive-name = Nom
preview-archive-size = Taille
preview-archive-modified = Modifié
preview-font-sample = Portez ce vieux whisky au juge blond qui fume
preview-table-rows = { $count ->
    [one] { $shown } ligne
   *[other] { $shown } lignes
}
preview-table-rows-capped = Plus de { $shown } lignes
