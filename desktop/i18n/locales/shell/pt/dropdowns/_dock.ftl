### Dock

dock-pin = Afixar na dock
dock-unpin = Desafixar da dock
dock-launch-failed = Não foi possível iniciar { $app }: { $error }
dock-no-desktop-entry = { $app } não tem uma entrada de ambiente de trabalho para o iniciar
dock-pin-failed = Não foi possível afixar { $app }: { $error }
dock-unpin-failed = Não foi possível desafixar { $app }: { $error }
