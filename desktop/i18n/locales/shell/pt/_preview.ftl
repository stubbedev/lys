## Vista rápida: a pré-visualização de um ficheiro
preview-kind-folder = Pasta
preview-kind-file = Ficheiro
preview-kind-typed = Ficheiro { $type }
preview-folder-items = { $count ->
    [one] { $shown } item
   *[other] { $shown } itens
}
preview-folder-items-capped = Mais de { $shown } itens
preview-size-at-least = pelo menos { $size }
preview-open = Abrir
preview-failed-unreadable = Não é possível ler este ficheiro.
preview-failed-undecodable = Não é possível mostrar este ficheiro: está danificado ou num formato ilegível.
preview-failed-too-large = Esta imagem é demasiado grande para pré-visualizar.
preview-failed-unsupported = Não é possível reproduzir este vídeo: o formato ou o codec não é suportado.
preview-document-damaged = O documento está danificado e não pode ser mostrado.
preview-document-encrypted = O documento está protegido com uma palavra-passe.
preview-document-too-large = A página é demasiado grande para ser mostrada.
preview-document-timeout = A página demorou demasiado a ser mostrada.
preview-document-unsupported = Este tipo de documento não pode ser mostrado.
preview-document-failed = Não foi possível mostrar o documento.
preview-archive-name = Nome
preview-archive-size = Tamanho
preview-archive-modified = Modificado
preview-font-sample = Luís argüia à Júlia que «brações, fé, chá, óxido, pôr, zângão» eram palavras do português
preview-table-rows = { $count ->
    [one] { $shown } linha
   *[other] { $shown } linhas
}
preview-table-rows-capped = Mais de { $shown } linhas
