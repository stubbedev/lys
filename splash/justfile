# lys-splash dev tasks.

# List all recipes with their descriptions.
default:
    @just --list

# Run every release gate in order: vet, lint, test, build.
check: vet lint no-fused test build

# Static analysis of every package with go vet.
vet:
    go vet ./...

# Fail on any float product fused into an FMA, which rounds differently from amd64.
no-fused:
    no-fused

# Lint every package; settings live in .golangci.yml.
lint:
    golangci-lint run

# Run the test suite for every package.
test:
    go test ./...

# Compile-check every package; the output is discarded.
build:
    go build -o /dev/null ./...

# Run nixpkgs' plymouth client against the server, in the nix sandbox.
plymouth-client:
    nix build --no-link -L .#checks.{{ arch() }}-{{ os() }}.splash-plymouth-client

# Format every Go source in place with gofmt.
fmt:
    gofmt -w .

# Install the compat output into Ubuntu as the install guide says, build an
# initramfs-tools image there, and check it holds the splash, the plymouth and
# plymouthd links, and the scripts in initramfs-tools' order (needs Docker).
[script("bash")]
initramfs-tools image="ubuntu:24.04":
    set -euo pipefail
    compat="$(nix build --no-link --print-out-paths ..#lys-splash.compat)"
    docker run --rm -v "${compat}:/compat:ro" "{{ image }}" bash -euo pipefail -c '
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -qq
      apt-get install -qq -y --no-install-recommends initramfs-tools linux-image-virtual zstd >/dev/null
      if dpkg -s plymouth >/dev/null 2>&1; then
        echo "plymouth is installed alongside lys-splash" >&2
        exit 1
      fi
      cp -dRf /compat/. /usr/
      kernel=$(ls /lib/modules | head -n1)
      mkinitramfs -o /tmp/initrd.img "$kernel"
      lsinitramfs /tmp/initrd.img > /tmp/files
      for want in usr/bin/lys-splash usr/bin/plymouth usr/sbin/plymouthd \
        scripts/init-premount/lys-splash scripts/init-bottom/lys-splash scripts/panic/lys-splash; do
        grep -qx "$want" /tmp/files || { echo "the image has no $want" >&2; exit 1; }
      done
      root=$(mktemp -d)
      unmkinitramfs /tmp/initrd.img "$root"
      main=$root/main
      [ -d "$main" ] || main=$root
      for phase in init-premount init-bottom panic; do
        grep -q "/scripts/$phase/lys-splash" "$main/scripts/$phase/ORDER" || { echo "scripts/$phase/ORDER does not run lys-splash" >&2; exit 1; }
      done
      [ "$(readlink -f "$main/usr/sbin/plymouthd")" = "$(readlink -f "$main/usr/bin/lys-splash")" ] || { echo "plymouthd does not lead to lys-splash" >&2; exit 1; }
      rc=0
      chroot "$main" /usr/bin/plymouth --ping || rc=$?
      [ "$rc" = 3 ] || { echo "plymouth --ping in the image exited $rc, want 3 with no daemon" >&2; exit 1; }
      echo "the initramfs-tools image holds lys-splash"
    '
